cmd_revoke() {
  local username="$1"
  local db="$2"

  if [[ ! "$username" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,31}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid username: $username\",\"code\":\"INVALID_USERNAME\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  local js="db.getSiblingDB('admin').revokeRolesFromUser('$username', [{role: 'readWrite', db: '$db'}, {role: 'read', db: '$db'}]); print(JSON.stringify({ok: 1}));"
  run_mongo_eval "$js" >/dev/null 2>&1 || true

  echo "{\"ok\":true,\"username\":\"$username\",\"database\":\"$db\",\"revoked\":true}"
  return $EXIT_SUCCESS
}

## ==================== ENGINE SERVICE LIFECYCLE ====================

cmd_engine_status() {
  local service="mongodb"
  local active=false
  local pid=0
  local uptime="0s"
  local status_text="stopped"

  for u in "mongodb.service" "mongod.service"; do
    if systemctl is-active --quiet "$u" 2>/dev/null; then
      service="${u%.service}"
      active=true
      status_text="running"
      pid="$(systemctl show -p MainPID --value "$u" 2>/dev/null || echo "0")"
      local uptime_sec
      uptime_sec="$(ps -p "$pid" -o etimes= 2>/dev/null | tr -d ' ' || echo "0")"
      if [[ "$uptime_sec" -gt 86400 ]]; then
        uptime="$((uptime_sec / 86400))d $((uptime_sec % 86400 / 3600))h"
      elif [[ "$uptime_sec" -gt 3600 ]]; then
        uptime="$((uptime_sec / 3600))h $((uptime_sec % 3600 / 60))m"
      else
        uptime="${uptime_sec}s"
      fi
      break
    fi
  done

  local version=""
  if [[ -n "$MONGOD_BIN" ]]; then
    local raw_v
    raw_v="$("$MONGOD_BIN" --version 2>/dev/null || echo "")"
    if [[ "$raw_v" =~ db[[:space:]]+version[[:space:]]+v?([0-9]+\.[0-9]+\.[0-9]+) ]]; then
      version="MongoDB ${BASH_REMATCH[1]}"
    else
      version="MongoDB"
    fi
  fi

  local conns=0
  if [[ "$active" == "true" ]]; then
    local c
    c="$(run_mongo_eval "try { print(db.serverStatus().connections.current); } catch(e) { print(0); }" 2>/dev/null || echo "0")"
    conns="$(echo "$c" | grep -Eo '^[0-9]+$' | tail -n 1 || echo "0")"
    conns="${conns:-0}"
  fi

  echo "{\"ok\":true,\"engine\":\"mongodb\",\"service\":\"$service\",\"status\":\"$status_text\",\"active\":$active,\"pid\":$pid,\"uptime\":\"$uptime\",\"version\":\"$version\",\"connections\":$conns,\"port\":27017}"
  return $EXIT_SUCCESS
}

cmd_engine_start() {
  echo "[1/3] Preparing /opt/hostpanel isolated directories, user and unit..."
  ensure_mongodb_user
  ensure_mongodb_config
  ensure_mongodb_service

  echo "[2/3] Starting MongoDB 8.0 service..."
  systemctl daemon-reload 2>/dev/null || true
  systemctl start mongodb.service 2>&1 || true

  echo "[3/3] Checking MongoDB socket and daemon listener..."
  local running=false
  for i in {1..10}; do
    if systemctl is-active --quiet mongodb.service 2>/dev/null; then
      running=true
      break
    fi
    sleep 0.3
  done

  if [[ "$running" == "true" ]]; then
    local pid
    pid="$(systemctl show -p MainPID --value mongodb.service 2>/dev/null || echo "0")"
    echo "✓ MongoDB 8.0 daemon is active (PID $pid, port 27017)."
    echo '{"ok":true,"action":"start","status":"active"}'
    return $EXIT_SUCCESS
  else
    echo "✗ MongoDB service failed to start!" >&2
    echo "--- Systemd Journal Logs (last 25 lines) ---" >&2
    journalctl -u mongodb.service -n 25 --no-pager >&2 || true
    echo '{"ok":false,"action":"start","error":"MongoDB service failed to start","code":"START_FAILED"}' >&2
    return $EXIT_EXECUTION_FAILED
  fi
}

cmd_engine_stop() {
  echo "[1/2] Sending termination signal to MongoDB 8.0 service..."
  systemctl stop mongodb.service 2>/dev/null || systemctl stop mongod.service 2>/dev/null || true

  echo "[2/2] Verifying process termination..."
  sleep 0.5
  echo "✓ MongoDB service stopped."
  echo '{"ok":true,"action":"stop","status":"inactive"}'
  return $EXIT_SUCCESS
}

cmd_engine_restart() {
  echo "[1/4] Stopping active MongoDB daemon..."
  systemctl stop mongodb.service 2>/dev/null || systemctl stop mongod.service 2>/dev/null || true

  echo "[2/4] Verifying isolated directories, user and permissions..."
  ensure_mongodb_user
  ensure_mongodb_config
  ensure_mongodb_service

  echo "[3/4] Starting MongoDB 8.0 service..."
  systemctl daemon-reload 2>/dev/null || true
  systemctl start mongodb.service 2>&1 || true

  echo "[4/4] Verifying MongoDB daemon health..."
  local running=false
  for i in {1..10}; do
    if systemctl is-active --quiet mongodb.service 2>/dev/null; then
      running=true
      break
    fi
    sleep 0.3
  done

  if [[ "$running" == "true" ]]; then
    local pid
    pid="$(systemctl show -p MainPID --value mongodb.service 2>/dev/null || echo "0")"
    echo "✓ MongoDB 8.0 restarted successfully (PID $pid, port 27017)."
    echo '{"ok":true,"action":"restart","status":"active"}'
    return $EXIT_SUCCESS
  else
    echo "✗ MongoDB service failed to restart!" >&2
    echo "--- Systemd Journal Logs (last 25 lines) ---" >&2
    journalctl -u mongodb.service -n 25 --no-pager >&2 || true
    echo '{"ok":false,"action":"restart","error":"MongoDB service failed to restart","code":"RESTART_FAILED"}' >&2
    return $EXIT_EXECUTION_FAILED
  fi
}

cmd_engine_reload() {
  echo "[1/2] Reloading MongoDB service..."
  cmd_engine_restart
}

cmd_engine_config_get() {
  local target="$CONF_FILE"
  if [[ ! -f "$target" ]]; then
    target="/etc/mongod.conf"
  fi
  if [[ ! -f "$target" ]]; then
    target="/etc/mongodb.conf"
  fi

  local content=""
  if [[ -f "$target" ]]; then
    content="$(cat "$target")"
  fi

  python3 -c 'import sys, json; print(json.dumps({"ok": True, "path": sys.argv[1], "content": sys.argv[2]}))' "$target" "$content"
  return $EXIT_SUCCESS
}

cmd_engine_config_set() {
  local content=""
  if [[ ! -t 0 ]]; then
    content="$(read_secret "content")"
  fi

  if [[ -z "$content" ]]; then
    echo '{"ok":false,"error":"Configuration content required in payload","code":"MISSING_CONFIG"}' >&2
    return $EXIT_INVALID_INPUT
  fi

  mkdir -p "$CONF_DIR"
  echo "$content" > "$CONF_FILE"
  chmod 0644 "$CONF_FILE"
  chown mongodb:mongodb "$CONF_FILE" 2>/dev/null || true

  # Restart engine to apply
  cmd_engine_restart >/dev/null 2>&1 || true

  echo "{\"ok\":true,\"path\":\"$CONF_FILE\",\"saved\":true}"
  return $EXIT_SUCCESS
}

cmd_engine_logs() {
  local lines="${1:-50}"
  if [[ ! "$lines" =~ ^[0-9]+$ ]]; then
    lines=50
  fi
  local out=""
  for u in "mongodb.service" "mongod.service"; do
    local j
    j="$(journalctl -u "$u" -n "$lines" --no-pager 2>/dev/null || true)"
    if [[ -n "$j" && "$j" != *"-- No entries --"* ]]; then
      out="$j"
      break
    fi
  done
  if [[ -z "$out" && -f "$LOG_FILE" ]]; then
    out="$(tail -n "$lines" "$LOG_FILE" 2>/dev/null || true)"
  fi
  if [[ -z "$out" && -f "/var/log/mongodb/mongod.log" ]]; then
    out="$(tail -n "$lines" "/var/log/mongodb/mongod.log" 2>/dev/null || true)"
  fi
  python3 -c 'import sys, json; print(json.dumps({"ok": True, "lines": sys.argv[1], "content": sys.argv[2]}))' "$lines" "${out:-No log output recorded.}"
  return $EXIT_SUCCESS
}

cmd_engine_install() {
  echo "============================================================"
  echo "  HostPanel v3 — MongoDB 8.0 Engine Provisioner"
  echo "============================================================"
  echo

  mkdir -p "$CONF_DIR" "$DATA_DIR" "$LOG_DIR" "$RUN_DIR" "$RUNTIME_DIR"
  ensure_mongodb_user
  ensure_mongodb_config

  echo "[1/4] Checking / Provisioning MongoDB 8.0 runtime..."
  local arch; arch="$(uname -m)"
  local mongo_dl_url=""
  local mongosh_dl_url=""

  if [[ "$arch" == "aarch64" || "$arch" == "arm64" ]]; then
    mongo_dl_url="https://fastdl.mongodb.org/linux/mongodb-linux-aarch64-ubuntu2404-8.0.4.tgz"
    mongosh_dl_url="https://downloads.mongodb.com/compass/mongosh-2.3.8-linux-arm64.tgz"
  else
    mongo_dl_url="https://fastdl.mongodb.org/linux/mongodb-linux-x86_64-ubuntu2404-8.0.4.tgz"
    mongosh_dl_url="https://downloads.mongodb.com/compass/mongosh-2.3.8-linux-x64.tgz"
  fi

  if [[ ! -x "${RUNTIME_DIR}/bin/mongod" ]]; then
    echo "  Downloading MongoDB 8.0.4 server binaries ($arch)..."
    mkdir -p "${RUNTIME_DIR}/bin" "${RUNTIME_DIR}/tmp"
    local tgz="${RUNTIME_DIR}/tmp/mongodb.tgz"
    if curl -fSL --progress-bar "$mongo_dl_url" -o "$tgz"; then
      echo "  Extracting MongoDB 8.0.4 binaries..."
      tar -xzvf "$tgz" --strip-components=1 -C "${RUNTIME_DIR}"
      rm -f "$tgz"
    else
      echo "  Binary download fallback via system packages..."
      if command -v apt-get >/dev/null 2>&1; then
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -y || true
        apt-get install -y --no-install-recommends mongodb-org mongodb-org-server || \
        apt-get install -y --no-install-recommends mongodb || true
      fi
    fi
  fi

  if [[ ! -x "${RUNTIME_DIR}/bin/mongosh" ]]; then
    echo "  Downloading MongoDB Shell (mongosh) ($arch)..."
    mkdir -p "${RUNTIME_DIR}/bin" "${RUNTIME_DIR}/tmp"
    local tgz_sh="${RUNTIME_DIR}/tmp/mongosh.tgz"
    if curl -fSL "$mongosh_dl_url" -o "$tgz_sh"; then
      echo "  Extracting mongosh..."
      tar -xzvf "$tgz_sh" --strip-components=1 -C "${RUNTIME_DIR}"
      rm -f "$tgz_sh"
    fi
  fi
  rm -rf "${RUNTIME_DIR}/tmp"

  echo
  echo "[2/4] Setting up isolated database paths, user and permissions..."
  ensure_mongodb_user
  ensure_mongodb_config

  echo
  echo "[3/4] Configuring isolated MongoDB systemd unit..."
  ensure_mongodb_service

  echo
  echo "[4/4] Starting service and validating engine..."
  systemctl daemon-reload
  systemctl enable mongodb.service 2>/dev/null || true
  systemctl restart mongodb.service 2>&1 || true

  local running=false
  for i in {1..10}; do
    if systemctl is-active --quiet mongodb.service 2>/dev/null; then
      running=true
      break
    fi
    sleep 0.3
  done

  if [[ "$running" == "true" ]]; then
    local pid
    pid="$(systemctl show -p MainPID --value mongodb.service 2>/dev/null || echo "0")"
    echo
    echo "✓ MongoDB engine ready and isolated under /opt/hostpanel (PID $pid, port 27017)"
    echo '{"ok":true,"engine":"mongodb","status":"installed"}'
    return $EXIT_SUCCESS
  else
    echo
    echo "✗ MongoDB service failed to start after install!" >&2
    echo "--- Systemd Journal Logs (last 25 lines) ---" >&2
    journalctl -u mongodb.service -n 25 --no-pager >&2 || true
    echo '{"ok":false,"engine":"mongodb","status":"failed","error":"MongoDB service failed to start"}' >&2
    return $EXIT_EXECUTION_FAILED
  fi
}

