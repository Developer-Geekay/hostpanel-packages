cmd_collection_query() {
  local db="$1"
  local col="$2"
  local limit="${3:-50}"

  if [[ ! "$db" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,63}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid database name: $db\",\"code\":\"INVALID_NAME\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  if [[ ! "$col" =~ ^[a-zA-Z0-9_.-]{1,120}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid collection name: $col\",\"code\":\"INVALID_COLLECTION\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  local filter=""
  if [[ ! -t 0 ]]; then
    filter="$(read_secret "filter")"
  fi

  if [[ -z "$filter" ]]; then
    filter="{}"
  fi

  local start_time
  start_time="$(python3 -c 'import time; print(time.time())')"

  local js="
try {
  const target = db.getSiblingDB('$db');
  let query = $filter;
  let docs = target['$col'].find(query).limit($limit).toArray();
  let count = target['$col'].countDocuments(query);
  print('HOSTPANEL_QUERY_RESULT:' + EJSON.stringify({ ok: true, database: '$db', collection: '$col', documents: docs, count: count }, { relaxed: true }));
} catch(e) {
  print('HOSTPANEL_QUERY_RESULT:' + JSON.stringify({ ok: false, error: e.message || String(e) }));
}
"
  local raw
  raw="$(run_mongo_eval "$js" || true)"

  python3 -c '
import sys, time, json

db = sys.argv[1]
col = sys.argv[2]
raw = sys.argv[3]
start = float(sys.argv[4])
duration_ms = round((time.time() - start) * 1000, 2)

result = None
for line in raw.split("\n"):
    if "HOSTPANEL_QUERY_RESULT:" in line:
        try:
            result = json.loads(line.split("HOSTPANEL_QUERY_RESULT:", 1)[1])
            break
        except Exception:
            pass

if result is None:
    print(json.dumps({"ok": False, "error": "Failed to parse query output", "code": "EVAL_FAILED", "execution_time_ms": duration_ms}))
else:
    result["execution_time_ms"] = duration_ms
    print(json.dumps(result))
' "$db" "$col" "$raw" "$start_time"
  return $EXIT_SUCCESS
}

cmd_user_list() {
  local res
  res="$(run_mongo_eval "try { print(JSON.stringify(db.adminCommand({usersInfo: 1}).users)); } catch(e) { print('[]'); }" || echo "[]")"
  local list="[]"
  list="$(python3 - "$res" <<'PYEOF'
import sys, json
raw = sys.argv[1].strip()
protected = {"root", "__system"}
users = []
try:
    data = json.loads(raw)
    for u in data:
        uname = u.get("user", "")
        if uname and uname not in protected:
            users.append({
                "username": uname,
                "database": u.get("db", "admin"),
                "roles": [r.get("role") for r in u.get("roles", [])]
            })
except Exception:
    pass
print(json.dumps(users))
PYEOF
)"
  echo "{\"ok\":true,\"users\":$list}"
  return $EXIT_SUCCESS
}

cmd_user_create() {
  local username="$1"
  local db="${2:-admin}"
  local roles="${3:-readWrite}"

  if [[ ! "$username" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,31}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid username: $username\",\"code\":\"INVALID_USERNAME\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  if is_protected_user "$username"; then
    echo "{\"ok\":false,\"error\":\"User '$username' is protected\",\"code\":\"FORBIDDEN\"}" >&2
    return $EXIT_FORBIDDEN
  fi

  local password=""
  if [[ ! -t 0 ]]; then
    password="$(read_secret "password")"
  fi

  if [[ -z "$password" ]]; then
    echo '{"ok":false,"error":"Password required on stdin JSON payload","code":"MISSING_PASSWORD"}' >&2
    return $EXIT_INVALID_INPUT
  fi

  local js="db.getSiblingDB('$db').createUser({user: '$username', pwd: '$password', roles: [{role: '$roles', db: '$db'}]}); print(JSON.stringify({ok: 1}));"
  run_mongo_eval "$js" >/dev/null 2>&1 || true

  echo "{\"ok\":true,\"username\":\"$username\",\"database\":\"$db\",\"roles\":\"$roles\"}"
  return $EXIT_SUCCESS
}

cmd_user_drop() {
  local username="$1"
  local db="${2:-admin}"

  if [[ ! "$username" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,31}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid username: $username\",\"code\":\"INVALID_USERNAME\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  if is_protected_user "$username"; then
    echo "{\"ok\":false,\"error\":\"Cannot drop protected user '$username'\",\"code\":\"FORBIDDEN\"}" >&2
    return $EXIT_FORBIDDEN
  fi

  local js="db.getSiblingDB('$db').dropUser('$username'); print(JSON.stringify({ok: 1}));"
  run_mongo_eval "$js" >/dev/null 2>&1 || true

  echo "{\"ok\":true,\"username\":\"$username\",\"database\":\"$db\",\"dropped\":true}"
  return $EXIT_SUCCESS
}

