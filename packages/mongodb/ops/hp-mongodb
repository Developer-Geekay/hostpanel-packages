#!/usr/bin/env bash
#
# /opt/hostpanel/packages/mongodb/ops/hp-mongodb
#
# Ops worker for MongoDB database management under HostPanel v3.
# Enforces 100% isolation under /opt/hostpanel.
#
set -euo pipefail

# Error Codes
EXIT_SUCCESS=0
EXIT_INTERNAL_ERROR=10
EXIT_COMMAND_NOT_FOUND=11
EXIT_INVALID_INPUT=12
EXIT_PRECONDITION_FAILED=13
EXIT_FORBIDDEN=14
EXIT_EXECUTION_FAILED=20

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORE_LIB="${HP_CORE_LIB:-/opt/hostpanel/hpcore/lib}"
if [[ -f "${CORE_LIB}/common.sh" ]]; then
  # shellcheck source=/dev/null
  source "${CORE_LIB}/common.sh"
fi

# Paths under /opt/hostpanel
HP_ROOT="${HP_ROOT:-/opt/hostpanel}"
CONF_DIR="${HP_ROOT}/etc/mongodb"
CONF_FILE="${CONF_DIR}/mongod.conf"
DATA_DIR="${HP_ROOT}/data/mongodb"
LOG_DIR="${HP_ROOT}/logs/mongodb"
LOG_FILE="${LOG_DIR}/mongod.log"
RUN_DIR="${HP_ROOT}/run/mongodb"
RUNTIME_DIR="${HP_ROOT}/runtimes/mongodb"

# Detect mongosh / mongo binary
MONGO_BIN=""
if [[ -x "${RUNTIME_DIR}/bin/mongosh" ]]; then
  MONGO_BIN="${RUNTIME_DIR}/bin/mongosh"
elif [[ -x "${RUNTIME_DIR}/bin/mongo" ]]; then
  MONGO_BIN="${RUNTIME_DIR}/bin/mongo"
elif command -v mongosh >/dev/null 2>&1; then
  MONGO_BIN="mongosh"
elif command -v mongo >/dev/null 2>&1; then
  MONGO_BIN="mongo"
fi

# Detect mongod
MONGOD_BIN=""
if [[ -x "${RUNTIME_DIR}/bin/mongod" ]]; then
  MONGOD_BIN="${RUNTIME_DIR}/bin/mongod"
elif command -v mongod >/dev/null 2>&1; then
  MONGOD_BIN="mongod"
fi

# Protected databases & users
PROTECTED_DBS=("admin" "config" "local")
PROTECTED_USERS=("root" "__system")

is_protected_db() {
  local name="$1"
  for p in "${PROTECTED_DBS[@]}"; do
    if [[ "$name" == "$p" ]]; then return 0; fi
  done
  return 1
}

is_protected_user() {
  local user="$1"
  for u in "${PROTECTED_USERS[@]}"; do
    if [[ "$user" == "$u" ]]; then return 0; fi
  done
  return 1
}

ensure_mongodb_user() {
  if ! getent group mongodb >/dev/null 2>&1; then
    groupadd -r mongodb 2>/dev/null || true
  fi
  if ! getent passwd mongodb >/dev/null 2>&1; then
    useradd -r -g mongodb -s /bin/false -M -d "$DATA_DIR" mongodb 2>/dev/null || true
  fi
  usermod -aG mongodb mongodb 2>/dev/null || true
}

ensure_mongodb_service() {
  # Stop and disable system mongod.service if present to avoid port 27017 conflict
  if systemctl list-unit-files 2>/dev/null | grep -q "^mongod\.service"; then
    if systemctl is-active --quiet mongod.service 2>/dev/null; then
      systemctl stop mongod.service 2>/dev/null || true
    fi
    systemctl disable mongod.service 2>/dev/null || true
  fi

  local mongod_exec="${RUNTIME_DIR}/bin/mongod"
  if [[ ! -x "$mongod_exec" ]]; then
    mongod_exec="$(command -v mongod || echo "/usr/local/bin/mongod")"
  fi

  local svc_file="/etc/systemd/system/mongodb.service"
  cat > "$svc_file" <<EOF
[Unit]
Description=MongoDB Database Server (HostPanel Isolated)
Documentation=https://docs.mongodb.org/manual
After=network-online.target
Wants=network-online.target

[Service]
User=mongodb
Group=mongodb
Type=simple
ExecStart=$mongod_exec --config $CONF_FILE
PIDFile=$RUN_DIR/mongod.pid
Restart=always
RestartSec=2
TimeoutSec=30
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=$DATA_DIR $LOG_DIR $RUN_DIR $CONF_DIR /tmp
LimitNOFILE=64000
LimitNPROC=64000
TasksMax=infinity

[Install]
WantedBy=multi-user.target
EOF
  chmod 0644 "$svc_file"
  systemctl daemon-reload 2>/dev/null || true
}

ensure_mongodb_config() {
  mkdir -p "$CONF_DIR" "$DATA_DIR" "$LOG_DIR" "$RUN_DIR"
  if [[ -d "$RUNTIME_DIR" ]]; then
    chmod -R a+rX "$RUNTIME_DIR" 2>/dev/null || true
  fi

  if [[ ! -f "$CONF_FILE" ]]; then
    cat > "$CONF_FILE" <<EOF
storage:
  dbPath: $DATA_DIR

systemLog:
  destination: file
  path: $LOG_DIR/mongod.log
  logAppend: true

net:
  port: 27017
  bindIp: 127.0.0.1
  unixDomainSocket:
    enabled: true
    pathPrefix: $RUN_DIR

processManagement:
  pidFilePath: $RUN_DIR/mongod.pid
EOF
    chmod 0644 "$CONF_FILE"
  fi

  # If an existing config has timeZoneInfo pointing to missing tzdata, comment it out
  if [[ -f "$CONF_FILE" ]] && ! [[ -d "/usr/share/zoneinfo" ]]; then
    sed -i 's/^[[:space:]]*timeZoneInfo:[[:space:]]*\/usr\/share\/zoneinfo/# timeZoneInfo: \/usr\/share\/zoneinfo/' "$CONF_FILE" 2>/dev/null || true
  fi

  chown -R mongodb:mongodb "$DATA_DIR" "$LOG_DIR" "$RUN_DIR" "$CONF_DIR" 2>/dev/null || true
  chmod 0755 "$DATA_DIR" "$LOG_DIR" "$RUN_DIR" "$CONF_DIR" 2>/dev/null || true
}

find_mongo_socket() {
  local candidates=(
    "${RUN_DIR}/mongodb-27017.sock"
    "${RUN_DIR}/mongod.sock"
    "/tmp/mongodb-27017.sock"
    "/var/run/mongodb/mongod.sock"
  )
  for sock in "${candidates[@]}"; do
    if [[ -S "$sock" ]]; then
      echo "$sock"
      return 0
    fi
  done
  echo ""
}

read_secret() {
  local target_key="$1"
  python3 -c '
import sys
target = sys.argv[1]
try:
    raw = sys.stdin.buffer.read()
    if not raw:
        sys.exit(0)
    parts = raw.split(b"\0")
    if len(parts) > 1:
        for i in range(0, len(parts) - 1, 2):
            k = parts[i].decode("utf-8", errors="replace")
            v = parts[i+1].decode("utf-8", errors="replace")
            if k == target:
                sys.stdout.write(v)
                sys.exit(0)
    import json
    data = json.loads(raw.decode("utf-8", errors="replace"))
    if isinstance(data, dict) and target in data:
        sys.stdout.write(str(data[target]))
        sys.exit(0)
except Exception:
    pass
' "$target_key"
}

run_mongo_eval() {
  local expr="$1"
  if [[ -z "$MONGO_BIN" ]]; then
    echo '{"ok":false,"error":"MongoDB shell client binary not found","code":"DEPENDENCY_MISSING"}' >&2
    return $EXIT_INTERNAL_ERROR
  fi
  export HOME=/tmp
  export MONGOSH_DISABLE_TELEMETRY=1
  local sock
  sock="$(find_mongo_socket)"
  if [[ -n "$sock" ]]; then
    local sock_enc
    sock_enc="$(python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1], safe=""))' "$sock" 2>/dev/null || echo "")"
    if [[ -n "$sock_enc" ]]; then
      "$MONGO_BIN" --norc --quiet "mongodb://${sock_enc}" --eval "$expr" 2>/dev/null || \
      "$MONGO_BIN" --norc --quiet "mongodb://127.0.0.1:27017" --eval "$expr" 2>/dev/null
    else
      "$MONGO_BIN" --norc --quiet "mongodb://127.0.0.1:27017" --eval "$expr" 2>/dev/null
    fi
  else
    "$MONGO_BIN" --norc --quiet "mongodb://127.0.0.1:27017" --eval "$expr" 2>/dev/null
  fi
}

format_bytes() {
  local b="${1:-0}"
  if [[ "$b" -lt 1024 ]]; then
    echo "${b} B"
  elif [[ "$b" -lt 1048576 ]]; then
    awk "BEGIN {printf \"%.1f KB\", $b/1024}"
  elif [[ "$b" -lt 1073741824 ]]; then
    awk "BEGIN {printf \"%.1f MB\", $b/1048576}"
  else
    awk "BEGIN {printf \"%.1f GB\", $b/1073741824}"
  fi
}

# ==================== VERBS ====================

cmd_db_list() {
  local res
  res="$(run_mongo_eval 'try { print(EJSON.stringify(db.adminCommand({listDatabases: 1}).databases, { relaxed: true })); } catch(e) { print("[]"); }' || echo "[]")"
  local list="[]"
  list="$(python3 - "$res" <<'PYEOF'
import sys, json

def to_int(v):
    if isinstance(v, (int, float)):
        return int(v)
    if isinstance(v, dict):
        low = v.get("low", 0)
        high = v.get("high", 0)
        return (high << 32) + low if high else low
    try:
        return int(v)
    except Exception:
        return 0

raw = sys.argv[1].strip() if len(sys.argv) > 1 else ""
protected = {"admin", "config", "local"}
dbs = []
try:
    data = json.loads(raw) if raw else []
    for item in data:
        name = item.get("name", "")
        if name and name not in protected:
            size = to_int(item.get("sizeOnDisk", 0))
            dbs.append({
                "name": name,
                "size_bytes": size,
                "size_human": f"{size // 1024} KB" if size >= 1024 else f"{size} B",
                "empty": item.get("empty", False)
            })
except Exception:
    pass
print(json.dumps(dbs))
PYEOF
)"
  echo "{\"ok\":true,\"databases\":$list,\"total\":$(echo "$list" | python3 -c 'import sys, json; print(len(json.load(sys.stdin)))')}"
  return $EXIT_SUCCESS
}

cmd_db_create() {
  local name="$1"

  if [[ ! "$name" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,63}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid database name: $name\",\"code\":\"INVALID_NAME\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  if is_protected_db "$name"; then
    echo "{\"ok\":false,\"error\":\"Database name '$name' is protected\",\"code\":\"FORBIDDEN\"}" >&2
    return $EXIT_FORBIDDEN
  fi

  local res
  res="$(run_mongo_eval "db.getSiblingDB('$name').createCollection('_hp_init'); print(JSON.stringify({ok: 1}));" || echo '{"ok":0}')"
  if [[ "$res" == *"ok"* ]]; then
    echo "{\"ok\":true,\"name\":\"$name\",\"created\":true}"
    return $EXIT_SUCCESS
  else
    echo "{\"ok\":false,\"error\":\"Failed to create database '$name'\",\"code\":\"EXECUTION_FAILED\"}" >&2
    return $EXIT_EXECUTION_FAILED
  fi
}

cmd_db_drop() {
  local name="$1"

  if [[ ! "$name" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,63}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid database name: $name\",\"code\":\"INVALID_NAME\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  if is_protected_db "$name"; then
    echo "{\"ok\":false,\"error\":\"Cannot drop protected database '$name'\",\"code\":\"FORBIDDEN\"}" >&2
    return $EXIT_FORBIDDEN
  fi

  local res
  res="$(run_mongo_eval "db.getSiblingDB('$name').dropDatabase(); print(JSON.stringify({ok: 1}));" || echo '{"ok":0}')"
  echo "{\"ok\":true,\"name\":\"$name\",\"dropped\":true}"
  return $EXIT_SUCCESS
}

cmd_db_size() {
  local name="$1"
  if [[ ! "$name" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,63}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid database name: $name\",\"code\":\"INVALID_NAME\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  local res
  res="$(run_mongo_eval "try { var s = db.getSiblingDB('$name').stats(); print(EJSON.stringify({dataSize: s.dataSize || 0, storageSize: s.storageSize || 0}, { relaxed: true })); } catch(e) { print(JSON.stringify({dataSize: 0, storageSize: 0})); }" || echo '{"dataSize":0,"storageSize":0}')"
  local bytes
  bytes="$(echo "$res" | python3 -c 'import sys, json; data=json.load(sys.stdin) if sys.stdin else {}; print(int(data.get("dataSize", 0)))' 2>/dev/null || echo "0")"
  local human
  human="$(format_bytes "$bytes")"
  echo "{\"ok\":true,\"name\":\"$name\",\"size_bytes\":$bytes,\"size_human\":\"$human\"}"
  return $EXIT_SUCCESS
}

cmd_db_connections() {
  local res
  res="$(run_mongo_eval "try { var s = db.serverStatus(); print(s.connections.current); } catch(e) { print(0); }" || echo "0")"
  local count
  count="$(echo "$res" | grep -Eo '^[0-9]+$' | tail -n 1 || echo "0")"
  echo "{\"ok\":true,\"connections\":${count:-0}}"
  return $EXIT_SUCCESS
}

cmd_collection_list() {
  local db="$1"
  if [[ ! "$db" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,63}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid database name: $db\",\"code\":\"INVALID_NAME\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  local js="
try {
  const target = db.getSiblingDB('$db');
  const cols = target.getCollectionInfos();
  const list = cols.map(function(c) {
    let count = 0;
    let size = 0;
    try {
      count = target[c.name].countDocuments();
      const s = target[c.name].stats();
      size = s.size || 0;
    } catch(e) {}
    return { name: c.name, type: c.type || 'collection', count: count, size_bytes: size };
  });
  print('HOSTPANEL_JSON:' + EJSON.stringify(list, { relaxed: true }));
} catch(e) {
  print('HOSTPANEL_JSON:[]');
}
"
  local raw
  raw="$(run_mongo_eval "$js" || true)"

  python3 -c '
import sys, json

db = sys.argv[1]
raw = sys.argv[2]
cols = []

def to_int(v):
    if isinstance(v, (int, float)): return int(v)
    if isinstance(v, dict): return int(v.get("low", 0))
    try: return int(v)
    except Exception: return 0

def fmt(b):
    for unit in ["B", "KB", "MB", "GB"]:
        if b < 1024.0: return f"{b:.1f} {unit}" if unit != "B" else f"{b} B"
        b /= 1024.0
    return f"{b:.1f} TB"

for line in raw.split("\n"):
    if "HOSTPANEL_JSON:" in line:
        try:
            data = json.loads(line.split("HOSTPANEL_JSON:", 1)[1])
            for item in data:
                b = to_int(item.get("size_bytes", 0))
                item["count"] = to_int(item.get("count", 0))
                item["size_bytes"] = b
                item["size_human"] = fmt(b)
                cols.append(item)
        except Exception:
            pass
print(json.dumps({"ok": True, "database": db, "collections": cols, "total": len(cols)}))
' "$db" "$raw"
  return $EXIT_SUCCESS
}

