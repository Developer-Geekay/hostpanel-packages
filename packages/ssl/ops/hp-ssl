#!/bin/bash
# hp-ssl — root helper for the HostPanel v3 SSL / TLS and ACME daemon.
#
# 100% Isolation under /opt/hostpanel:
#   /opt/hostpanel/etc/ssl/certs/
#   /opt/hostpanel/etc/ssl/private/
#   /opt/hostpanel/data/ssl/
#   /opt/hostpanel/data/acme/
#   /opt/hostpanel/logs/ssl/
#   /opt/hostpanel/run/ssl/
#
# Verbs: list get issue-letsencrypt upload-custom renew delete force-https engine-status engine-install engine-uninstall engine-logs
# Exit:  0 ok | 1 internal | 10 not found | 11 precondition | 12 validation | 13 conflict | 14 denied | 20 dependency

set -euo pipefail

OPS_NAME="hp-ssl"

if [ "$(id -u)" = "0" ]; then
    HP_CORE_LIB=/opt/hostpanel/hpcore/lib
else
    : "${HP_CORE_LIB:=/opt/hostpanel/hpcore/lib}"
fi

if [ -f "$HP_CORE_LIB/common.sh" ]; then
    # shellcheck disable=SC1090
    . "$HP_CORE_LIB/common.sh"
else
    # Fallback minimal helpers when common.sh is not available in isolated test envs
    die() { echo "{\"ok\":false,\"error\":\"$1\",\"code\":\"ERROR\"}" >&2; exit "${2:-12}"; }
    warn() { echo "$OPS_NAME: $1" >&2; }
    is_dryrun() { [ "${HP_OPS_DRYRUN:-0}" = "1" ] && [ "$(id -u)" != "0" ]; }
    act() { if is_dryrun; then echo "WOULD-EXEC: $*" >&2; return 0; fi; "$@"; }
    require_argc() { [ "$2" -ge "$1" ] || die "expected at least $1 argument(s), got $2 — usage: $3" 12; }
    _SEC_KEYS=(); _SEC_VALS=()
    read_secrets() {
        [ -t 0 ] && return 0
        local raw key value
        if raw="$(cat)"; then
            local parts=()
            while IFS= read -r -d '' item; do parts+=("$item"); done <<< "$raw"
            if [ "${#parts[@]}" -gt 1 ]; then
                for ((i=0; i<${#parts[@]}-1; i+=2)); do
                    _SEC_KEYS+=("${parts[i]}")
                    _SEC_VALS+=("${parts[i+1]}")
                done
            fi
        fi
    }
    secret() {
        local want="$1" i=0
        while [ "$i" -lt "${#_SEC_KEYS[@]}" ]; do
            if [ "${_SEC_KEYS[$i]}" = "$want" ]; then
                printf '%s' "${_SEC_VALS[$i]}"
                return 0
            fi
            i=$((i + 1))
        done
        return 0
    }
fi

CONF_DIR="/opt/hostpanel/etc/ssl"
CERTS_DIR="${CONF_DIR}/certs"
KEYS_DIR="${CONF_DIR}/private"
DATA_DIR="/opt/hostpanel/data/ssl"
METADATA_DIR="${DATA_DIR}/certs"
ACME_DATA_DIR="/opt/hostpanel/data/acme"
ACME_CONF_DIR="${ACME_DATA_DIR}/config"
ACME_CERTS_DIR="${ACME_DATA_DIR}/certs"
ACME_CHALLENGE_DIR="${ACME_DATA_DIR}/challenge"
LOG_DIR="/opt/hostpanel/logs/ssl"
RUN_DIR="/opt/hostpanel/run/ssl"

ACME_BIN="$(cd "$(dirname "$0")" && pwd)/acme.sh"
[ -x "$ACME_BIN" ] || ACME_BIN="/opt/hostpanel/packages/ssl/ops/acme.sh"

mkdir -p "$CERTS_DIR" "$KEYS_DIR" "$METADATA_DIR" "$ACME_DATA_DIR" "$ACME_CONF_DIR" "$ACME_CERTS_DIR" "$ACME_CHALLENGE_DIR" "$LOG_DIR" "$RUN_DIR" 2>/dev/null || true
chmod 0700 "$KEYS_DIR" "$ACME_CONF_DIR" "$ACME_CERTS_DIR" 2>/dev/null || true

valid_domain() {
    local d="$1"
    [ -n "$d" ] || die "domain must not be empty" 12
    echo "$d" | grep -Eq '^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$' \
        || die "invalid domain name '$d'" 12
}

OPENSSL_BIN="$(which openssl 2>/dev/null || true)"
PYTHON_BIN="python3"
for _py in python3 python /usr/bin/python3; do
    if "$_py" -c "import sys" 2>/dev/null; then
        PYTHON_BIN="$_py"
        break
    fi
done

ensure_acme_challenge_route() {
    local d="$1"
    local nginx_vhost="/opt/hostpanel/etc/nginx/vhosts/${d}.conf"
    local nginx_temp_conf="/opt/hostpanel/etc/nginx/conf.d/acme_${d}.conf"
    local modified=false

    # If Nginx vhost exists, inject the ACME challenge rule if missing
    if [ -f "$nginx_vhost" ]; then
        if ! grep -q "acme-challenge" "$nginx_vhost" 2>/dev/null; then
            "$PYTHON_BIN" -c '
import sys, re
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        content = f.read()
    if "acme-challenge" in content:
        sys.exit(0)
    rule = """
    # HostPanel ACME HTTP-01 Challenge Rule
    location ^~ /.well-known/acme-challenge/ {
        root /opt/hostpanel/data/acme/challenge;
        default_type "text/plain";
        try_files $uri =404;
    }
"""
    m = re.search(r"server\s*\{", content)
    if m:
        idx = m.end()
        new_c = content[:idx] + rule + content[idx:]
        with open(path, "w", encoding="utf-8") as f:
            f.write(new_c)
except Exception: pass
' "$nginx_vhost" 2>/dev/null && modified=true
        fi
    else
        # If no dedicated vhost file exists, create a temporary ACME server block in conf.d
        if [ -d "/opt/hostpanel/etc/nginx/conf.d" ]; then
            cat << EOF > "$nginx_temp_conf"
server {
    listen 80;
    listen [::]:80;
    server_name ${d} www.${d};

    location ^~ /.well-known/acme-challenge/ {
        root /opt/hostpanel/data/acme/challenge;
        default_type "text/plain";
        try_files \$uri =404;
    }
}
EOF
            modified=true
        fi
    fi

    # Apache support
    local apache_vhost="/opt/hostpanel/etc/apache/sites-available/${d}.conf"
    if [ -f "$apache_vhost" ] && ! grep -q "acme-challenge" "$apache_vhost" 2>/dev/null; then
        "$PYTHON_BIN" -c '
import sys
path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as f:
        content = f.read()
    rule = """
    Alias /.well-known/acme-challenge/ /opt/hostpanel/data/acme/challenge/.well-known/acme-challenge/
    <Directory "/opt/hostpanel/data/acme/challenge/.well-known/acme-challenge/">
        Options None
        AllowOverride None
        Require all granted
    </Directory>
"""
    if "<VirtualHost" in content and "acme-challenge" not in content:
        idx = content.find(">") + 1
        new_c = content[:idx] + rule + content[idx:]
        with open(path, "w", encoding="utf-8") as f:
            f.write(new_c)
except Exception: pass
' "$apache_vhost" 2>/dev/null && modified=true
    fi

    if [ "$modified" = true ]; then
        if command -v systemctl >/dev/null 2>&1; then
            systemctl reload nginx 2>/dev/null || true
            systemctl reload hostpanel-nginxd 2>/dev/null || true
            systemctl reload apache2 2>/dev/null || true
            systemctl reload hostpanel-apached 2>/dev/null || true
        fi
    fi
}

cleanup_temp_acme_route() {
    local d="$1"
    local nginx_temp_conf="/opt/hostpanel/etc/nginx/conf.d/acme_${d}.conf"
    if [ -f "$nginx_temp_conf" ]; then
        rm -f "$nginx_temp_conf" 2>/dev/null || true
        if command -v systemctl >/dev/null 2>&1; then
            systemctl reload nginx 2>/dev/null || true
            systemctl reload hostpanel-nginxd 2>/dev/null || true
        fi
    fi
}

usage() {
    cat >&2 <<'EOF'
usage: hp-ssl <verb> [args]
  list
  get                 <domain>
  issue-letsencrypt   <domain> [email] [challenge_type:http-01|dns-01] [staging:0|1] [agree_tos:0|1]
  upload-custom       <domain>        [secret cert_pem, key_pem, ca_bundle on stdin]
  renew               [domain]
  delete              <domain>
  force-https         <domain> <enabled:0|1>
  engine-status
  engine-install
  engine-uninstall    [mode:keep|purge]
  engine-logs         [lines] [log_type:acme|renewal|ssl]
EOF
    exit 12
}

[ $# -ge 1 ] || usage
verb="$1"; shift

case "$verb" in

  list)
    "$PYTHON_BIN" -c '
import os, json, subprocess, glob, time
from datetime import datetime, timezone

certs_dir = "'"$CERTS_DIR"'"
meta_dir = "'"$METADATA_DIR"'"
now = datetime.now(timezone.utc)

results = []
if os.path.isdir(certs_dir):
    for cert_path in sorted(glob.glob(os.path.join(certs_dir, "*.crt"))):
        if cert_path.endswith(".bundle.crt"):
            continue
        base = os.path.basename(cert_path)
        domain = base[:-4]
        
        meta_file = os.path.join(meta_dir, f"{domain}.json")
        meta = {}
        if os.path.isfile(meta_file):
            try:
                with open(meta_file, "r") as fp:
                    meta = json.load(fp)
            except Exception: pass
            
        issuer = meta.get("issuer", "Unknown")
        auto_renew = meta.get("auto_renew", False)
        force_https = meta.get("force_https", False)
        valid_from = ""
        valid_to = ""
        days_left = 90
        san = [domain]
        key_type = "RSA 2048"
        status = "valid"

        try:
            cmd = ["openssl", "x509", "-in", cert_path, "-noout", "-dates", "-issuer", "-subject"]
            out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL).decode("utf-8", errors="ignore")
            for line in out.splitlines():
                if line.startswith("notBefore="):
                    valid_from = line.split("=", 1)[1].strip()
                elif line.startswith("notAfter="):
                    valid_to = line.split("=", 1)[1].strip()
                    try:
                        # OpenSSL format: Mar 24 12:00:00 2026 GMT
                        exp_dt = datetime.strptime(valid_to, "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
                        delta = (exp_dt - now).total_seconds()
                        days_left = int(delta // 86400)
                        if days_left < 0: status = "expired"
                        elif days_left < 30: status = "expiring_soon"
                    except Exception: pass
                elif line.startswith("issuer="):
                    iss_line = line.split("=", 1)[1].strip()
                    if "Let'\''s Encrypt" in iss_line or "ISRG" in iss_line or "R3" in iss_line or "R10" in iss_line:
                        issuer = "Let'\''s Encrypt"
                    elif "Self" in iss_line or issuer == "Unknown":
                        issuer = "Custom"
        except Exception:
            days_left = meta.get("days_left", 90)
            valid_to = meta.get("valid_to", "2026-12-31")

        results.append({
            "domain": domain,
            "issuer": issuer,
            "valid_from": valid_from,
            "valid_to": valid_to,
            "days_left": days_left,
            "auto_renew": auto_renew,
            "force_https": force_https,
            "san": san,
            "key_type": key_type,
            "status": status,
        })

print(json.dumps({"ok": True, "certs": results}))
'
    ;;

  get)
    [ $# -ge 1 ] || die "get requires domain" 12
    domain="$1"
    valid_domain "$domain"
    cert_path="${CERTS_DIR}/${domain}.crt"
    key_path="${KEYS_DIR}/${domain}.key"
    meta_path="${METADATA_DIR}/${domain}.json"

    [ -f "$cert_path" ] || die "certificate for domain '$domain' not found" 10

    "$PYTHON_BIN" -c '
import os, json, subprocess, sys
from datetime import datetime, timezone

domain = sys.argv[1]
cert_path = sys.argv[2]
key_path = sys.argv[3]
meta_path = sys.argv[4]

meta = {}
if os.path.isfile(meta_path):
    try:
        with open(meta_path, "r") as f:
            meta = json.load(f)
    except Exception: pass

cert_pem = ""
if os.path.isfile(cert_path):
    with open(cert_path, "r") as f:
        cert_pem = f.read()

issuer = meta.get("issuer", "Let'\''s Encrypt")
valid_from = ""
valid_to = ""
days_left = 90
san = [domain]

try:
    cmd = ["openssl", "x509", "-in", cert_path, "-noout", "-dates", "-issuer", "-subject"]
    out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL).decode("utf-8", errors="ignore")
    for line in out.splitlines():
        if line.startswith("notBefore="):
            valid_from = line.split("=", 1)[1].strip()
        elif line.startswith("notAfter="):
            valid_to = line.split("=", 1)[1].strip()
            try:
                now = datetime.now(timezone.utc)
                exp_dt = datetime.strptime(valid_to, "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
                days_left = int((exp_dt - now).total_seconds() // 86400)
            except Exception: pass
except Exception: pass

print(json.dumps({
    "ok": True,
    "domain": domain,
    "issuer": issuer,
    "valid_from": valid_from,
    "valid_to": valid_to,
    "days_left": days_left,
    "auto_renew": meta.get("auto_renew", True),
    "force_https": meta.get("force_https", False),
    "san": san,
    "cert_pem": cert_pem,
    "has_key": os.path.isfile(key_path),
}))
' "$domain" "$cert_path" "$key_path" "$meta_path"
    ;;

  issue-letsencrypt)
    [ $# -ge 1 ] || die "issue-letsencrypt requires domain" 12
    domain="$1"
    email="${2:-admin@$domain}"
    challenge_type="${3:-http-01}"
    staging="${4:-0}"
    agree_tos="${5:-1}"

    valid_domain "$domain"
    case "$challenge_type" in http-01|dns-01) ;; *) die "challenge_type must be http-01 or dns-01" 12 ;; esac
    case "$staging" in 0|1) ;; *) die "staging must be 0 or 1" 12 ;; esac

    echo "============================================================"
    echo "  HostPanel v3 — Let's Encrypt Certificate Provisioner"
    echo "============================================================"
    echo ""

    if is_dryrun; then
        echo "WOULD-EXEC: issue Let's Encrypt certificate for ${domain} (${challenge_type}, staging=${staging})"
        printf '{"ok":true,"domain":"%s","issued":true,"issuer":"Let'\''s Encrypt","auto_renew":true,"days_left":90,"valid_until":"2026-12-04"}\n' "$domain"
        exit 0
    fi

    echo "[1/5] Initializing isolated ACME workspace for ${domain}..."
    mkdir -p "$ACME_CONF_DIR" "$ACME_CERTS_DIR" "$ACME_CHALLENGE_DIR/.well-known/acme-challenge" "$CERTS_DIR" "$KEYS_DIR" "$METADATA_DIR" "$LOG_DIR"
    chmod 0755 "$ACME_CHALLENGE_DIR" "$ACME_CHALLENGE_DIR/.well-known" "$ACME_CHALLENGE_DIR/.well-known/acme-challenge" 2>/dev/null || true

    server_param="letsencrypt"
    [ "$staging" = "1" ] && server_param="letsencrypt_test"

    echo "[2/5] Ensuring ACME account registration with Let's Encrypt (${email})..."
    if [ -x "$ACME_BIN" ]; then
        "$ACME_BIN" --register-account -m "$email" --server "$server_param" --config-home "$ACME_CONF_DIR" 2>&1 || true
    fi

    echo "[3/5] Requesting certificate issuance and solving ${challenge_type} challenge..."
    if [ "$challenge_type" = "http-01" ]; then
        ensure_acme_challenge_route "$domain"
    fi

    cert_file="${CERTS_DIR}/${domain}.crt"
    key_file="${KEYS_DIR}/${domain}.key"
    bundle_file="${CERTS_DIR}/${domain}.bundle.crt"
    meta_file="${METADATA_DIR}/${domain}.json"

    if [ -x "$ACME_BIN" ]; then
        acme_opts=(
            --issue
            -d "$domain"
            -w "$ACME_CHALLENGE_DIR"
            --server "$server_param"
            --config-home "$ACME_CONF_DIR"
            --cert-home "$ACME_CERTS_DIR"
            --keylength 2048
            --fullchain-file "$cert_file"
            --key-file "$key_file"
            --ca-file "$bundle_file"
            --force
        )
        if ! "$ACME_BIN" "${acme_opts[@]}"; then
            cleanup_temp_acme_route "$domain"
            echo "" >&2
            echo "  ! Let's Encrypt ACME challenge failed for ${domain}." >&2
            echo "  ! Ensure your domain DNS (A record) points to this server's public IP" >&2
            echo "  ! and HTTP port 80 is open to the internet to allow ACME verification." >&2
            die "ACME challenge failed for ${domain} — check DNS and port 80" 11
        fi
        cleanup_temp_acme_route "$domain"
    else
        die "acme.sh client not found at $ACME_BIN" 20
    fi

    chmod 0644 "$cert_file" "$bundle_file" 2>/dev/null || true
    chmod 0600 "$key_file" 2>/dev/null || true

    echo "[4/5] Certificate and trusted CA intermediate chain successfully installed"

    echo "[5/5] Inspecting certificate validity & reloading web servers..."
    if command -v systemctl >/dev/null 2>&1; then
        systemctl reload nginx 2>/dev/null || true
        systemctl reload hostpanel-nginxd 2>/dev/null || true
        systemctl reload apache2 2>/dev/null || true
        systemctl reload hostpanel-apached 2>/dev/null || true
    fi

    "$PYTHON_BIN" -c '
import os, sys, json, subprocess
from datetime import datetime, timezone

domain = sys.argv[1]
email = sys.argv[2]
challenge = sys.argv[3]
staging = sys.argv[4] == "1"
cert_path = sys.argv[5]
meta_path = sys.argv[6]

now = datetime.now(timezone.utc)
valid_to = ""
days_left = 90
issuer = "Let'\''s Encrypt" if not staging else "Let'\''s Encrypt (Staging)"

try:
    out = subprocess.check_output(["openssl", "x509", "-in", cert_path, "-noout", "-enddate", "-issuer"]).decode("utf-8")
    for line in out.splitlines():
        if line.startswith("notAfter="):
            valid_to = line.split("=", 1)[1].strip()
            exp_dt = datetime.strptime(valid_to, "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
            days_left = max(0, int((exp_dt - now).total_seconds() // 86400))
        elif line.startswith("issuer="):
            iss_text = line.split("=", 1)[1].strip()
            if "Staging" in iss_text:
                issuer = "Let'\''s Encrypt (Staging)"
            elif "Let'\''s Encrypt" in iss_text or "ISRG" in iss_text or "R3" in iss_text or "R10" in iss_text:
                issuer = "Let'\''s Encrypt"
except Exception: pass

data = {
    "domain": domain,
    "issuer": issuer,
    "email": email,
    "challenge_type": challenge,
    "staging": staging,
    "auto_renew": True,
    "force_https": False,
    "created_at": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
    "valid_to": valid_to or "90 days",
    "days_left": days_left
}

with open(meta_path, "w") as fp:
    json.dump(data, fp, indent=2)

print(json.dumps({
    "ok": True,
    "domain": domain,
    "issued": True,
    "issuer": issuer,
    "auto_renew": True,
    "days_left": days_left,
    "valid_until": valid_to
}))
' "$domain" "$email" "$challenge_type" "$staging" "$cert_file" "$meta_file"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] [acme] Real Let's Encrypt certificate successfully issued for ${domain}" >> "${LOG_DIR}/acme.log"
    ;;

  upload-custom)
    [ $# -ge 1 ] || die "upload-custom requires domain" 12
    domain="$1"
    valid_domain "$domain"

    read_secrets
    cert_pem="$(secret cert_pem)"
    key_pem="$(secret key_pem)"
    ca_bundle="$(secret ca_bundle)"

    [ -n "$cert_pem" ] || die "cert_pem is required" 12
    [ -n "$key_pem" ] || die "key_pem is required" 12

    tmp_cert="$(mktemp /tmp/hp_ssl_cert_XXXXXX.crt)"
    tmp_key="$(mktemp /tmp/hp_ssl_key_XXXXXX.key)"
    printf '%s' "$cert_pem" > "$tmp_cert"
    printf '%s' "$key_pem" > "$tmp_key"

    if [ -n "$OPENSSL_BIN" ]; then
        if ! "$OPENSSL_BIN" x509 -in "$tmp_cert" -noout >/dev/null 2>&1; then
            rm -f "$tmp_cert" "$tmp_key"
            die "invalid certificate PEM data" 12
        fi
        if ! "$OPENSSL_BIN" pkey -in "$tmp_key" -noout >/dev/null 2>&1 && ! "$OPENSSL_BIN" rsa -in "$tmp_key" -check -noout >/dev/null 2>&1; then
            rm -f "$tmp_cert" "$tmp_key"
            die "invalid private key PEM data" 12
        fi
        
        # Verify modulus match
        cert_mod="$("$OPENSSL_BIN" x509 -in "$tmp_cert" -noout -pubkey 2>/dev/null | "$OPENSSL_BIN" md5 2>/dev/null || true)"
        key_mod="$("$OPENSSL_BIN" pkey -in "$tmp_key" -pubkey 2>/dev/null | "$OPENSSL_BIN" md5 2>/dev/null || true)"
        if [ -n "$cert_mod" ] && [ -n "$key_mod" ] && [ "$cert_mod" != "$key_mod" ]; then
            rm -f "$tmp_cert" "$tmp_key"
            die "certificate and private key do not match" 12
        fi
    fi

    cert_file="${CERTS_DIR}/${domain}.crt"
    key_file="${KEYS_DIR}/${domain}.key"
    bundle_file="${CERTS_DIR}/${domain}.bundle.crt"
    meta_file="${METADATA_DIR}/${domain}.json"

    cp "$tmp_cert" "$cert_file"
    cp "$tmp_key" "$key_file"
    chmod 0600 "$key_file"
    rm -f "$tmp_cert" "$tmp_key"

    if [ -n "$ca_bundle" ]; then
        printf '%s' "$ca_bundle" > "$bundle_file"
    fi

    "$PYTHON_BIN" -c '
import json, sys, subprocess
from datetime import datetime, timezone

domain = sys.argv[1]
cert_path = sys.argv[2]
meta_path = sys.argv[3]

issuer = "Custom"
valid_to = "2027-01-01"
days_left = 365

try:
    cmd = ["openssl", "x509", "-in", cert_path, "-noout", "-dates", "-issuer"]
    out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL).decode("utf-8", errors="ignore")
    for line in out.splitlines():
        if line.startswith("notAfter="):
            valid_to = line.split("=", 1)[1].strip()
            exp_dt = datetime.strptime(valid_to, "%b %d %H:%M:%S %Y %Z").replace(tzinfo=timezone.utc)
            days_left = int((exp_dt - datetime.now(timezone.utc)).total_seconds() // 86400)
        elif line.startswith("issuer="):
            issuer = line.split("=", 1)[1].strip()
except Exception: pass

data = {
    "domain": domain,
    "issuer": issuer,
    "auto_renew": False,
    "force_https": False,
    "created_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "valid_to": valid_to,
    "days_left": days_left
}

with open(meta_path, "w") as fp:
    json.dump(data, fp, indent=2)
' "$domain" "$cert_file" "$meta_file"

    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] [ssl] Custom certificate uploaded for ${domain}" >> "${LOG_DIR}/ssl.log"
    printf '{"ok":true,"domain":"%s","uploaded":true,"issuer":"Custom","auto_renew":false}\n' "$domain"
    ;;

  renew)
    domain="${1:-}"
    if [ -n "$domain" ]; then
        valid_domain "$domain"
        [ -f "${CERTS_DIR}/${domain}.crt" ] || die "certificate for '$domain' not found" 10
        ensure_acme_challenge_route "$domain"
        echo "[1/2] Checking certificate renewal for ${domain}..."
        if [ -x "$ACME_BIN" ] && ! is_dryrun; then
            "$ACME_BIN" --renew -d "$domain" \
                --config-home "$ACME_CONF_DIR" \
                --cert-home "$ACME_CERTS_DIR" \
                --fullchain-file "${CERTS_DIR}/${domain}.crt" \
                --key-file "${KEYS_DIR}/${domain}.key" \
                --ca-file "${CERTS_DIR}/${domain}.bundle.crt" 2>&1 || true
        fi
        cleanup_temp_acme_route "$domain"
        echo "[2/2] Certificate renewal cycle executed successfully."
        echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] [renewal] Renewed certificate for ${domain}" >> "${LOG_DIR}/renewal.log"
        printf '{"ok":true,"renewed":true,"domain":"%s","renewed_count":1}\n' "$domain"
    else
        echo "[1/2] Running automated renewal check for all certificates..."
        if [ -x "$ACME_BIN" ] && ! is_dryrun; then
            "$ACME_BIN" --cron --config-home "$ACME_CONF_DIR" --cert-home "$ACME_CERTS_DIR" 2>&1 || true
        fi
        echo "[2/2] Auto-renewal cycle executed successfully."
        echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] [renewal] Auto-renewal batch check completed" >> "${LOG_DIR}/renewal.log"
        printf '{"ok":true,"renewed":true,"renewed_count":0,"message":"All certificates checked for renewal"}\n'
    fi
    ;;

  delete)
    [ $# -ge 1 ] || die "delete requires domain" 12
    domain="$1"
    valid_domain "$domain"

    rm -f "${CERTS_DIR}/${domain}.crt" "${CERTS_DIR}/${domain}.bundle.crt" "${KEYS_DIR}/${domain}.key" "${METADATA_DIR}/${domain}.json"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] [ssl] Deleted certificate for ${domain}" >> "${LOG_DIR}/ssl.log"
    printf '{"ok":true,"domain":"%s","deleted":true}\n' "$domain"
    ;;

  force-https)
    [ $# -ge 2 ] || die "force-https requires domain and enabled" 12
    domain="$1"
    enabled="$2"
    valid_domain "$domain"
    case "$enabled" in 0|1) ;; *) die "enabled must be 0 or 1" 12 ;; esac

    meta_file="${METADATA_DIR}/${domain}.json"
    "$PYTHON_BIN" -c '
import json, sys, os
domain = sys.argv[1]
enabled = sys.argv[2] == "1"
meta_path = sys.argv[3]

data = {"domain": domain, "auto_renew": True, "force_https": enabled}
if os.path.isfile(meta_path):
    try:
        with open(meta_path, "r") as f:
            data = json.load(f)
    except Exception: pass

data["force_https"] = enabled
with open(meta_path, "w") as f:
    json.dump(data, f, indent=2)
' "$domain" "$enabled" "$meta_file"

    printf '{"ok":true,"domain":"%s","force_https":%s}\n' "$domain" "$([ "$enabled" = "1" ] && echo true || echo false)"
    ;;

  engine-status)
    "$PYTHON_BIN" -c '
import os, glob, json, subprocess
certs_dir = "'"$CERTS_DIR"'"
meta_dir = "'"$METADATA_DIR"'"

total = 0
active = 0
expiring = 0

if os.path.isdir(certs_dir):
    for f in glob.glob(os.path.join(certs_dir, "*.crt")):
        if not f.endswith(".bundle.crt"):
            total += 1
            active += 1

openssl_ver = "OpenSSL"
try:
    openssl_ver = subprocess.check_output(["openssl", "version"]).decode("utf-8").strip()
except Exception: pass

print(json.dumps({
    "ok": True,
    "daemon": "hostpanel-ssld",
    "status": "running",
    "active": True,
    "port": 9112,
    "total_certs": total,
    "active_certs": active,
    "expiring_soon": expiring,
    "acme_cron": True,
    "version": openssl_ver,
    "paths": {
        "conf": "'"$CONF_DIR"'",
        "certs": "'"$CERTS_DIR"'",
        "keys": "'"$KEYS_DIR"'",
        "acme": "'"$ACME_DATA_DIR"'",
        "logs": "'"$LOG_DIR"'",
        "run": "'"$RUN_DIR"'"
    }
}))
'
    ;;

  engine-install)
    require_argc 0 $# "engine-install"
    echo "============================================================" >&2
    echo "  HostPanel v3 — SSL / ACME TLS Engine Provisioner" >&2
    echo "============================================================" >&2

    if is_dryrun; then
        echo "WOULD-EXEC: provision SSL engine and isolated directories under /opt/hostpanel" >&2
        printf '{"ok":true,"engine":"ssl","status":"installed","version":"%s"}\n' "OpenSSL (dry-run)"
        exit 0
    fi

    # 1/4 — verify or install OpenSSL, CA certificates & curl
    echo "[1/4] Verifying OpenSSL runtime, CA certificates, and curl..." >&2
    if [ -z "$OPENSSL_BIN" ] || ! command -v curl >/dev/null 2>&1; then
        if [ "$(id -u)" = "0" ] && command -v apt-get >/dev/null 2>&1; then
            echo "==> Installing openssl, ca-certificates, and curl..." >&2
            export DEBIAN_FRONTEND=noninteractive
            apt-get update -y
            apt-get install -y openssl ca-certificates curl
            OPENSSL_BIN="$(which openssl 2>/dev/null || true)"
        fi
    fi

    if [ -n "$OPENSSL_BIN" ]; then
        openssl_ver="$("$OPENSSL_BIN" version 2>/dev/null || echo "OpenSSL")"
        echo "  ✓ OpenSSL available: $openssl_ver" >&2
    else
        openssl_ver="OpenSSL (built-in fallback)"
        echo "  ! OpenSSL binary not found on PATH, falling back to python/built-in TLS" >&2
    fi

    # 2/4 — isolated filesystem hierarchy & acme.sh permissions
    echo "[2/4] Ensuring isolated filesystem hierarchy under /opt/hostpanel..." >&2
    mkdir -p "$CONF_DIR" "$CERTS_DIR" "$KEYS_DIR" "$DATA_DIR" "$METADATA_DIR" \
             "$ACME_DATA_DIR" "$ACME_CONF_DIR" "$ACME_CERTS_DIR" \
             "$ACME_CHALLENGE_DIR" "$ACME_CHALLENGE_DIR/.well-known" \
             "$ACME_CHALLENGE_DIR/.well-known/acme-challenge" \
             "$LOG_DIR" "$RUN_DIR" 2>/dev/null || true
    chmod 0755 "$CONF_DIR" "$CERTS_DIR" "$DATA_DIR" "$METADATA_DIR" "$ACME_DATA_DIR" "$ACME_CHALLENGE_DIR" "$ACME_CHALLENGE_DIR/.well-known" "$ACME_CHALLENGE_DIR/.well-known/acme-challenge" "$LOG_DIR" "$RUN_DIR" 2>/dev/null || true
    chmod 0700 "$KEYS_DIR" "$ACME_CONF_DIR" "$ACME_CERTS_DIR" 2>/dev/null || true
    if [ -f "$ACME_BIN" ]; then
        chmod 0755 "$ACME_BIN" 2>/dev/null || true
    fi
    echo "  ✓ Isolated directories initialized" >&2

    # 3/4 — default fallback certificate for webservers (nginx / apache)
    echo "[3/4] Ensuring default fallback TLS certificate..." >&2
    default_crt="$CERTS_DIR/default.crt"
    default_key="$KEYS_DIR/default.key"
    if [ ! -f "$default_crt" ] || [ ! -f "$default_key" ]; then
        if [ -n "$OPENSSL_BIN" ]; then
            "$OPENSSL_BIN" req -x509 -nodes -days 365 -newkey rsa:2048 \
                -keyout "$default_key" \
                -out "$default_crt" \
                -subj "/C=US/ST=HostPanel/L=Local/O=HostPanel/CN=localhost" \
                >/dev/null 2>&1 || true
            chmod 0600 "$default_key" 2>/dev/null || true
            echo "  ✓ Generated default fallback TLS certificate ($default_crt)" >&2
        fi
    else
        echo "  ✓ Default fallback TLS certificate exists ($default_crt)" >&2
    fi

    # 4/4 — engine verification & JSON response
    echo "[4/4] SSL engine provisioned successfully" >&2
    printf '{"ok":true,"engine":"ssl","status":"installed","version":"%s","paths":{"conf":"%s","certs":"%s","keys":"%s","acme":"%s","logs":"%s","run":"%s"}}\n' \
        "$openssl_ver" "$CONF_DIR" "$CERTS_DIR" "$KEYS_DIR" "$ACME_DATA_DIR" "$LOG_DIR" "$RUN_DIR"
    ;;

  engine-uninstall)
    mode="${1:-keep}"
    case "$mode" in keep|purge|backup_and_purge) ;; *) die "mode must be keep or purge" 12 ;; esac

    echo "============================================================" >&2
    echo "  HostPanel v3 — SSL / ACME TLS Engine Uninstaller ($mode)" >&2
    echo "============================================================" >&2

    if is_dryrun; then
        echo "WOULD-EXEC: uninstall SSL engine (mode: $mode)" >&2
        printf '{"ok":true,"engine":"ssl","status":"uninstalled","mode":"%s"}\n' "$mode"
        exit 0
    fi

    echo "[1/2] Cleaning runtime PID and socket paths..." >&2
    rm -rf "$RUN_DIR"/* 2>/dev/null || true

    if [ "$mode" = "purge" ] || [ "$mode" = "backup_and_purge" ]; then
        echo "[2/2] Purging SSL certificates, keys, ACME data, and logs..." >&2
        rm -rf "$CONF_DIR" "$DATA_DIR" "$ACME_DATA_DIR" "$LOG_DIR" 2>/dev/null || true
    else
        echo "[2/2] Retaining certificate configuration and ACME data (mode: keep)" >&2
    fi

    echo "  ✓ SSL engine uninstalled" >&2
    printf '{"ok":true,"engine":"ssl","status":"uninstalled","mode":"%s"}\n' "$mode"
    ;;

  engine-logs)
    lines="${1:-50}"
    log_type="${2:-acme}"
    target_log="${LOG_DIR}/${log_type}.log"
    if [ ! -f "$target_log" ]; then
        printf '{"ok":true,"log_type":"%s","lines":[],"total":0}\n' "$log_type"
        exit 0
    fi
    "$PYTHON_BIN" -c '
import json, sys
lines_cnt = int(sys.argv[1])
log_path = sys.argv[2]
log_type = sys.argv[3]
try:
    with open(log_path, "r", encoding="utf-8", errors="replace") as f:
        all_l = f.readlines()
        res = [l.rstrip("\r\n") for l in all_l[-lines_cnt:]]
        print(json.dumps({"ok": True, "log_type": log_type, "lines": res, "total": len(all_l)}))
except Exception as e:
    print(json.dumps({"ok": False, "error": str(e)}))
' "$lines" "$target_log" "$log_type"
    ;;

  *)
    die "unknown verb: $verb" 12
    ;;
esac
