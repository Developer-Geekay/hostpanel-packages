    rm -rf "$HP_PHP_RUNTIMES_ROOT/$version" "$HP_PHP_ETC_ROOT/$version" "$HP_PHP_RUN_ROOT/php${version}-fpm*.sock" "$HP_PHP_RUN_ROOT/php${version}-fpm*.pid" 2>/dev/null || true

