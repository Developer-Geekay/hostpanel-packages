#!/bin/bash
# hp-php — root helper for the HostPanel v3 php daemon.
#
# Installed root-owned 0755. The daemon's sudoers file grants THIS SINGLE PATH
# and nothing else, so `hp-php` (the daemon account) can never write to
# /opt/hostpanel/etc/php/*/fpm/pool.d or restart a php-fpm unit directly — only
# through the validation below.
#
#   hp-php ALL=(root) NOPASSWD: /opt/hostpanel/packages/php/ops/hp-php *
#
# Verbs:
#   engine-status, engine-install, engine-uninstall, engine-action
#   version-list, version-install, version-uninstall, version-set-default
#   extension-list, extension-toggle, extension-install, extension-install-pecl, extension-install-so, extension-uninstall
#   config-get, config-set, directives-get, directives-set, logs-get
#   list-pools, get-pool, create-pool, delete-pool, set-pool-version, set-pool-limits, restart-fpm
#
# Exit:  0 ok | 1 internal | 10 not found | 11 precondition | 12 validation
#        13 conflict | 14 denied | 20 dependency
#
# stdout is DATA (JSON where structured). stderr is DIAGNOSTICS.
#
# 100% Isolation under /opt/hostpanel:
# - Runtimes & Binaries: /opt/hostpanel/runtimes/php/<version>/ (bin, sbin, lib/modules)
# - Configurations:     /opt/hostpanel/etc/php/<version>/ (fpm, cli, conf.d, pool.d, mods-available)
# - Runtime Sockets:    /opt/hostpanel/run/php/php<version>-fpm.sock
# - Logs:               /opt/hostpanel/logs/php/php<version>-fpm.log

set -euo pipefail

# OPS_NAME is consumed by die()/warn() in common.sh
# shellcheck disable=SC2034
OPS_NAME="hp-php"

# Shared validators live in hpcore
if [ "$(id -u)" = "0" ]; then
    HP_CORE_LIB=/opt/hostpanel/hpcore/lib
else
    : "${HP_CORE_LIB:=/opt/hostpanel/hpcore/lib}"
    if [ ! -f "$HP_CORE_LIB/common.sh" ]; then
        HP_CORE_LIB="$(cd "$(dirname "$0")/../../../hpcore/lib" 2>/dev/null && pwd || echo "/opt/hostpanel/hpcore/lib")"
    fi
fi

# shellcheck disable=SC1091
. "$HP_CORE_LIB/common.sh"

# 100% Isolation Root Paths
HP_ROOT="${HP_ROOT:-/opt/hostpanel}"
HP_PHP_RUNTIMES_ROOT="${HP_PHP_RUNTIMES_ROOT:-$HP_ROOT/runtimes/php}"
HP_PHP_ETC_ROOT="${HP_PHP_ETC_ROOT:-$HP_ROOT/etc/php}"
HP_PHP_RUN_ROOT="${HP_PHP_RUN_ROOT:-$HP_ROOT/run/php}"
HP_PHP_LOG_ROOT="${HP_PHP_LOG_ROOT:-$HP_ROOT/logs/php}"

# Reserved pool
RESERVED_POOL="www"

# Known PHP versions (Standard Single Runtime)
SUPPORTED_VERSIONS=("8.4")

# Known catalog of extensions with categories and install methods
CATALOG_EXTENSIONS=(
    "bcmath:Web & Core:Precision mathematics library:builtin"
    "bz2:Web & Core:Bzip2 data compression:builtin"
    "calendar:Web & Core:Calendar conversion routines:builtin"
    "ctype:Web & Core:Character type checking:builtin"
    "curl:Web & Core:cURL HTTP/HTTPS client:builtin"
    "dom:Web & Core:Document Object Model parser:builtin"
    "exif:Web & Core:Read and write image metadata:builtin"
    "fileinfo:Web & Core:File type identification:builtin"
    "gd:Web & Core:Image creation and manipulation:builtin"
    "iconv:Web & Core:Character set conversion:builtin"
    "intl:Web & Core:Internationalization functions (ICU):builtin"
    "mbstring:Web & Core:Multibyte string support for UTF-8:builtin"
    "openssl:Web & Core:OpenSSL cryptography:builtin"
    "phar:Web & Core:PHP Archive archives:builtin"
    "posix:Web & Core:POSIX system call bindings:builtin"
    "readline:Web & Core:Readline CLI editing:builtin"
    "session:Web & Core:HTTP Session management:builtin"
    "simplexml:Web & Core:SimpleXML parser:builtin"
    "soap:Web & Core:SOAP protocol client and server:builtin"
    "sockets:Web & Core:Low-level network sockets:builtin"
    "tokenizer:Web & Core:PHP source tokenizer:builtin"
    "xml:Web & Core:XML parsing and generation:builtin"
    "zip:Web & Core:Zip archive compression:builtin"
    "zlib:Web & Core:Zlib compression:builtin"
    "mysqli:Database:MySQL Improved driver:builtin"
    "pdo:Database:PHP Data Objects abstraction:builtin"
    "pdo_mysql:Database:MySQL driver for PDO:builtin"
    "pdo_pgsql:Database:PostgreSQL driver for PDO:builtin"
    "pdo_sqlite:Database:SQLite driver for PDO:builtin"
    "pgsql:Database:PostgreSQL database driver:builtin"
    "sqlite3:Database:SQLite 3 database driver:builtin"
    "redis:Database:High-performance in-memory Redis client:pecl"
    "mongodb:Database:MongoDB official driver:pecl"
    "memcached:Database:Memcached distributed cache client:pecl"
    "opcache:Performance:Zend OPcache bytecode cache:builtin"
    "apcu:Performance:APC User Cache memory cache:pecl"
    "swoole:Performance:High-performance async coroutine framework:pecl"
    "xdebug:Performance:Debugging and profiling tool:pecl"
    "imagick:Web & Core:ImageMagick image processing:pecl"
    "ioncube:Proprietary Loaders:IonCube Loader for encoded PHP files:direct_so"
    "sourceguardian:Proprietary Loaders:SourceGuardian runtime loader:direct_so"
)

usage() {
    cat >&2 <<'EOF'
usage: hp-php <verb> [args]
  engine-status
  engine-install
  engine-uninstall
  engine-action         <start|stop|restart|reload> [version]
  version-list
  version-install       <version>
  version-uninstall     <version>
  version-set-default   <version>
  extension-list        [version]
  extension-toggle      <version> <extension> <enabled>
  extension-install     <version> <extension>
  extension-install-pecl <version> <extension>
  extension-install-so  <version> <extension> <so_content_b64> [is_zend]
  extension-uninstall   <version> <extension>
  config-get            <version> [target:fpm|cli]
  config-set            <version> <content_b64> [target:fpm|cli]
  directives-get        <version>
  directives-set        <version> [upload_max] [post_max] [memory] [max_exec] [max_input_time] [max_input_vars] [timezone] [display_errors] [opcache]
  logs-get              [version] [log_type:error|slow] [lines]
  list-pools            [version]
  get-pool              <pool>
  create-pool           <pool> <version> <memory-limit> <max-execution-time>
  delete-pool           <pool>
  set-pool-version      <pool> <new-version>
  set-pool-limits       <pool> <memory-limit> <max-execution-time>
  restart-fpm           [version]
EOF
    exit 12
}

valid_pool_name() {
    local p="$1"
    [ -n "$p" ] || die "pool name must not be empty" 12
    echo "$p" | grep -Eq '^[a-z][a-z0-9_-]{0,63}$' \
        || die "invalid pool name '$p' (want ^[a-z][a-z0-9_-]{0,63}\$)" 12
}

valid_php_version() {
    local v="$1"
    echo "$v" | grep -Eq '^[0-9]+\.[0-9]+$' \
        || die "invalid PHP version '$v' (want <major>.<minor>, e.g. 8.3)" 12
}

valid_memory_limit() {
    echo "$1" | grep -Eq '^[0-9]{1,6}[KMG]$' \
        || die "invalid memory limit '$1' (want digits followed by K, M or G, e.g. 256M)" 12
}

valid_exec_time() {
    echo "$1" | grep -Eq '^[0-9]{1,5}$' \
        || die "invalid max execution time '$1' (want an integer number of seconds)" 12
}

valid_extension_name() {
    local ext="$1"
    [ -n "$ext" ] || die "extension name must not be empty" 12
    echo "$ext" | grep -Eq '^[a-z0-9_.-]{1,64}$' \
        || die "invalid extension name '$ext' (want ^[a-z0-9_.-]{1,64}\$)" 12
}

guard_reserved_pool() {
    [ "$1" != "$RESERVED_POOL" ] \
        || die "'$1' is the distribution default pool and cannot be deleted through the panel" 14
}

installed_versions() {
    local v list=()
    for v in "${SUPPORTED_VERSIONS[@]}"; do
        if [ -x "$HP_PHP_RUNTIMES_ROOT/$v/bin/php" ] && [ -x "$HP_PHP_RUNTIMES_ROOT/$v/sbin/php-fpm" ]; then
            list+=("$v")
        fi
    done
    printf '%s\n' "${list[@]}" | sort -V -r
}

version_installed() {
    local v="$1"
    [ -x "$HP_PHP_RUNTIMES_ROOT/$v/bin/php" ] && [ -x "$HP_PHP_RUNTIMES_ROOT/$v/sbin/php-fpm" ]
}

require_version_installed() {
    version_installed "$1" || die "PHP $1 is not installed" 10
}

fpm_unit() {
    local v="$1"
    printf 'hostpanel-php%s-fpm.service' "$v"
}

fpm_active() {
    local v="$1" unit
    unit="$(fpm_unit "$v")"
    if systemctl is-active --quiet "$unit" 2>/dev/null; then
        echo "active"
    elif systemctl is-failed --quiet "$unit" 2>/dev/null; then
        echo "failed"
    else
        echo "inactive"
    fi
}

pool_socket() {
    local pool="$1" version="$2"
    if [ "$pool" = "$RESERVED_POOL" ] || [ "$pool" = "default" ]; then
        printf '%s/php%s-fpm.sock' "$HP_PHP_RUN_ROOT" "$version"
    else
        printf '%s/php%s-fpm-%s.sock' "$HP_PHP_RUN_ROOT" "$version" "$pool"
    fi
}

pool_conf_path() {
    local pool="$1" version="$2" pooldir
    pooldir="$HP_PHP_ETC_ROOT/$version/fpm/pool.d"
    mkdir -p "$pooldir" 2>/dev/null || true
    echo "$pooldir/$pool.conf"
}

find_pool_version() {
    local pool="$1" v conf
    for v in $(installed_versions); do
        conf="$HP_PHP_ETC_ROOT/$v/fpm/pool.d/$pool.conf"
        if [ -f "$conf" ]; then
            printf '%s' "$v"
            return 0
        fi
    done
    return 1
}

sync_isolated_runtime() {
    local v="$1"
    local etc_dir="$HP_PHP_ETC_ROOT/$v"
    mkdir -p "$HP_PHP_RUN_ROOT" "$HP_PHP_LOG_ROOT" 2>/dev/null || true
    mkdir -p "$etc_dir/fpm/pool.d" "$etc_dir/fpm/conf.d" "$etc_dir/cli" "$etc_dir/mods-available" 2>/dev/null || true
    chown -R www-data:www-data "$HP_PHP_RUN_ROOT" "$HP_PHP_LOG_ROOT" 2>/dev/null || true
    chmod 755 "$HP_PHP_RUN_ROOT" "$HP_PHP_LOG_ROOT" 2>/dev/null || true
}

render_pool() {
    local pool="$1" version="$2" memory_limit="$3" max_exec="$4"
    cat <<EOF
; Managed by HostPanel — do not edit by hand. Regenerated on every change.
[$pool]
user = www-data
group = www-data
listen = $(pool_socket "$pool" "$version")
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = dynamic
pm.max_children = 5
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
php_admin_value[memory_limit] = ${memory_limit}
php_admin_value[max_execution_time] = ${max_exec}
EOF
}

pool_json() {
    local pool="$1" version="$2" conf="$3" mem exec_t
    mem="$(grep '^php_admin_value\[memory_limit\]' "$conf" 2>/dev/null | awk '{print $NF}' || echo "128M")"
    exec_t="$(grep '^php_admin_value\[max_execution_time\]' "$conf" 2>/dev/null | awk '{print $NF}' || echo "30")"
    printf '{"pool":"%s","version":"%s","memory_limit":"%s","max_execution_time":%d,"socket":"%s"}' \
        "$pool" "$version" "$mem" "$exec_t" "$(pool_socket "$pool" "$version")"
}

get_php_patch_version() {
    local v="${1:-8.4}"
    case "$v" in
        8.4) echo "8.4.4" ;;
        *) echo "8.4.4" ;;
    esac
}

ensure_isolated_configs() {
    local v="$1"
    local etc_dir="$HP_PHP_ETC_ROOT/$v"
    local run_dir="$HP_PHP_RUN_ROOT"
    local log_dir="$HP_PHP_LOG_ROOT"

    mkdir -p "$etc_dir/fpm/pool.d" "$etc_dir/fpm/conf.d" "$etc_dir/cli" "$etc_dir/mods-available" "$run_dir" "$log_dir" 2>/dev/null || true

    # Default php.ini
    if [ ! -f "$etc_dir/php.ini" ]; then
        cat <<EOF > "$etc_dir/php.ini"
[PHP]
engine = On
short_open_tag = Off
precision = 14
output_buffering = 4096
zlib.output_compression = Off
implicit_flush = Off
serialize_precision = -1
zend.enable_gc = On
expose_php = Off
max_execution_time = 120
max_input_time = 60
max_input_vars = 1000
memory_limit = 256M
error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT
display_errors = Off
display_startup_errors = Off
log_errors = On
log_errors_max_len = 1024
ignore_repeated_errors = Off
ignore_repeated_source = Off
report_memleaks = On
error_log = $log_dir/php${v}-error.log
variables_order = "GPCS"
request_order = "GP"
register_argc_argv = Off
auto_globals_jit = On
post_max_size = 64M
default_mimetype = "text/html"
default_charset = "UTF-8"
file_uploads = On
upload_max_filesize = 64M
max_file_uploads = 20
allow_url_fopen = On
allow_url_include = Off
default_socket_timeout = 60
date.timezone = UTC

[opcache]
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 128
opcache.interned_strings_buffer = 8
opcache.max_accelerated_files = 10000
opcache.revalidate_freq = 2
opcache.save_comments = 1
EOF
    fi

    # Create target-specific symlinks if not separate files
    [ -f "$etc_dir/fpm/php.ini" ] || cp -f "$etc_dir/php.ini" "$etc_dir/fpm/php.ini" 2>/dev/null || true
    [ -f "$etc_dir/cli/php.ini" ] || cp -f "$etc_dir/php.ini" "$etc_dir/cli/php.ini" 2>/dev/null || true

    # Default php-fpm.conf
    if [ ! -f "$etc_dir/fpm/php-fpm.conf" ]; then
        cat <<EOF > "$etc_dir/fpm/php-fpm.conf"
[global]
pid = $run_dir/php${v}-fpm.pid
error_log = $log_dir/php${v}-fpm.log
log_level = notice
daemonize = no
include = $etc_dir/fpm/pool.d/*.conf
EOF
    fi

    # Default www.conf pool
    if [ ! -f "$etc_dir/fpm/pool.d/www.conf" ]; then
        cat <<EOF > "$etc_dir/fpm/pool.d/www.conf"
[www]
user = hp-php
group = hp-php
listen = $run_dir/php${v}-fpm.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = dynamic
pm.max_children = 5
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
php_admin_value[memory_limit] = 128M
php_admin_value[max_execution_time] = 30
EOF
    fi
}

install_fpm_service() {
    local v="$1"
    local runtime_dir="$HP_PHP_RUNTIMES_ROOT/$v"
    local fpm_bin="$runtime_dir/sbin/php-fpm"
    [ -x "$fpm_bin" ] || fpm_bin="/usr/sbin/php-fpm$v"
    [ -x "$fpm_bin" ] || fpm_bin="$(command -v "php-fpm$v" 2>/dev/null || echo "")"
    [ -x "$fpm_bin" ] || fpm_bin="$(command -v php-fpm 2>/dev/null || echo "")"

    local unit_file="/etc/systemd/system/hostpanel-php${v}-fpm.service"
    local fpm_conf="$HP_PHP_ETC_ROOT/$v/fpm/php-fpm.conf"
    [ -f "$fpm_conf" ] || fpm_conf="/etc/php/$v/fpm/php-fpm.conf"

    if [ -x "$fpm_bin" ]; then
        cat <<EOF > "$unit_file"
[Unit]
Description=The PHP $v FastCGI Process Manager (HostPanel Isolated)
Documentation=man:php-fpm(8)
After=network.target

[Service]
Type=simple
PIDFile=$HP_PHP_RUN_ROOT/php${v}-fpm.pid
ExecStart=$fpm_bin --fpm-config $fpm_conf --nodaemonize
ExecReload=/bin/kill -USR2 \$MAINPID
Restart=always
RestartSec=2
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
        chmod 0644 "$unit_file"
        systemctl daemon-reload 2>/dev/null || true
        systemctl enable "hostpanel-php${v}-fpm.service" 2>/dev/null || true
        systemctl restart "hostpanel-php${v}-fpm.service" 2>/dev/null || true
    fi
}

install_php_runtime() {
    local version="$1"
    local patch_ver
    patch_ver="$(get_php_patch_version "$version")"
    local runtime_dir="$HP_PHP_RUNTIMES_ROOT/$version"
    local etc_dir="$HP_PHP_ETC_ROOT/$version"
    local run_dir="$HP_PHP_RUN_ROOT"
    local log_dir="$HP_PHP_LOG_ROOT"
    local arch
    arch="$(uname -m)"
    local arch_tag="x86_64"
    case "$arch" in
        x86_64) arch_tag="x86_64" ;;
        aarch64|arm64) arch_tag="aarch64" ;;
        *) arch_tag="x86_64" ;;
    esac

    mkdir -p "$runtime_dir/bin" "$runtime_dir/sbin" "$runtime_dir/lib/modules" "$etc_dir/fpm/pool.d" "$etc_dir/fpm/conf.d" "$etc_dir/cli" "$etc_dir/mods-available" "$run_dir" "$log_dir" 2>/dev/null || true

    local installed_ok=false

    # ── Strategy 1: Pre-compiled HostPanel Portable PHP Binary Tarball (Tier 1) ──
    echo "  [1/4] Checking for pre-compiled portable PHP $version ($arch_tag) binary tarball..." >&2
    local portable_url="https://github.com/hostpanel/php-runtimes/releases/download/v${patch_ver}/php-${patch_ver}-linux-${arch_tag}.tar.gz"
    local cache_tar="/opt/hostpanel/runtimes/cache/php-${patch_ver}-linux-${arch_tag}.tar.gz"
    local repo_tar="/srv/hostpanel-v3/packages/php/runtimes/php-${patch_ver}-linux-${arch_tag}.tar.gz"
    local pkg_tar="/opt/hostpanel/packages/php/runtimes/php-${patch_ver}-linux-${arch_tag}.tar.gz"
    local tmp_tar="/tmp/php-${version}-${arch_tag}.tar.gz"

    if [ -f "$cache_tar" ]; then
        echo "  [+] Extracting cached portable PHP $version runtime from $cache_tar..." >&2
        tar -xzf "$cache_tar" -C "$runtime_dir" 2>&1
        if [ -x "$runtime_dir/bin/php" ] && [ -x "$runtime_dir/sbin/php-fpm" ]; then
            installed_ok=true
            echo "  ✓ Portable PHP $version runtime unpacked successfully from cache (<2s)." >&2
        fi
    elif [ -f "$repo_tar" ]; then
        echo "  [+] Extracting local portable PHP $version runtime from $repo_tar..." >&2
        tar -xzf "$repo_tar" -C "$runtime_dir" 2>&1
        if [ -x "$runtime_dir/bin/php" ] && [ -x "$runtime_dir/sbin/php-fpm" ]; then
            installed_ok=true
            echo "  ✓ Portable PHP $version runtime unpacked successfully from local package (<2s)." >&2
        fi
    elif [ -f "$pkg_tar" ]; then
        echo "  [+] Extracting bundled portable PHP $version runtime from $pkg_tar..." >&2
        tar -xzf "$pkg_tar" -C "$runtime_dir" 2>&1
        if [ -x "$runtime_dir/bin/php" ] && [ -x "$runtime_dir/sbin/php-fpm" ]; then
            installed_ok=true
            echo "  ✓ Portable PHP $version runtime unpacked successfully from bundle (<2s)." >&2
        fi
    elif curl -sSLf --connect-timeout 5 --max-time 60 "$portable_url" -o "$tmp_tar" 2>/dev/null; then
        echo "  [+] Extracting portable PHP $version runtime into $runtime_dir..." >&2
        tar -xzf "$tmp_tar" -C "$runtime_dir" --strip-components=1 2>/dev/null || tar -xzf "$tmp_tar" -C "$runtime_dir"
        rm -f "$tmp_tar"
        if [ -x "$runtime_dir/bin/php" ] && [ -x "$runtime_dir/sbin/php-fpm" ]; then
            installed_ok=true
            echo "  ✓ Pre-compiled portable PHP $version runtime unpacked successfully." >&2
        fi
    fi

    # ── Enforce Zero-Compilation Standalone Runtime Guarantee ──
    if [ "$installed_ok" != "true" ]; then
        die "Pre-compiled portable PHP $version archive (php-${patch_ver}-linux-${arch_tag}.tar.gz) not found in cache or package repository. HostPanel runtimes must be provisioned via standalone pre-compiled archives without compilation on the host." 20
    fi

    # ── 3. Configure default isolated php.ini and php-fpm.conf ──
    echo "  [3/4] Initializing isolated configuration in $etc_dir..." >&2
    ensure_isolated_configs "$version"

    # ── 4. Install dedicated systemd service for hostpanel-php$version-fpm ──
    echo "  [4/4] Activating HostPanel PHP $version FPM service daemon..." >&2
    install_fpm_service "$version"

    echo "  ✓ PHP $version isolated runtime ready." >&2
}

# ── Main Entrypoint ───────────────────────────────────────────────────────────

[ $# -ge 1 ] || usage
verb="$1"
shift

case "$verb" in
  # ── engine lifecycle ────────────────────────────────────────────────────────
  engine-status)
    require_argc 0 $# "engine-status"
    installed_arr=($(installed_versions))
    has_installed=false
    has_active=false
    [ ${#installed_arr[@]} -gt 0 ] && has_installed=true

    ver_json=""
    first=1
    for v in "${installed_arr[@]}"; do
        sync_isolated_runtime "$v"
        st="$(fpm_active "$v")"
        [ "$st" = "active" ] && has_active=true

        pool_count=0
        if [ -d "$HP_PHP_ETC_ROOT/$v/fpm/pool.d" ]; then
            pool_count=$(find "$HP_PHP_ETC_ROOT/$v/fpm/pool.d" -maxdepth 1 -name "*.conf" 2>/dev/null | wc -l)
        fi

        [ "$first" = "1" ] && first=0 || ver_json="${ver_json},"
        ver_json="${ver_json}$(printf '{"version":"%s","active":"%s","status":"%s","path":"%s/runtimes/php/%s/bin/php","socket":"%s","pool_count":%d}' \
            "$v" "$st" "$st" "$HP_ROOT" "$v" "$(pool_socket "www" "$v")" "$pool_count")"
    done

    printf '{"installed":%s,"active":%s,"versions":[%s],"default_version":"8.4"}\n' "$has_installed" "$has_active" "$ver_json"
    ;;

  engine-install)
    require_argc 0 $# "engine-install"
    echo "============================================================" >&2
    echo "  HostPanel v3 — PHP Runtime Provisioner (Standalone)" >&2
    echo "============================================================" >&2
    if is_dryrun; then
        echo "WOULD-EXEC: install standalone PHP 8.4 runtime under /opt/hostpanel" >&2
        printf '{"status":"installed","version":"8.4","isolated":true}\n'
        exit 0
    fi

    target_ver="8.4"
    install_php_runtime "$target_ver"
    printf '{"status":"installed","version":"%s","active":true,"socket":"%s"}\n' "$target_ver" "$(pool_socket "www" "$target_ver")"
    ;;

  engine-uninstall)
    require_argc 0 $# "engine-uninstall"
    echo "==> Stopping all PHP-FPM service daemons..." >&2
    if is_dryrun; then
        echo "WOULD-EXEC: stop all php-fpm services and clean sockets" >&2
        printf '{"status":"uninstalled"}\n'
        exit 0
    fi

    for v in "${SUPPORTED_VERSIONS[@]}"; do
        if systemctl is-active "$(fpm_unit "$v")" >/dev/null 2>&1; then
            echo "  stopping PHP $v FPM..." >&2
            systemctl stop "$(fpm_unit "$v")" 2>/dev/null || true
            systemctl disable "$(fpm_unit "$v")" 2>/dev/null || true
        fi
    done
    rm -rf "$HP_PHP_RUN_ROOT"/*.sock "$HP_PHP_RUN_ROOT"/*.pid 2>/dev/null || true
    echo "  ✓ All PHP engine daemons stopped and cleaned." >&2
    printf '{"status":"uninstalled"}\n'
    ;;

  engine-action)
    require_argc 1 $# "engine-action <start|stop|restart|reload> [version]"
    action="$1"
    target_ver="${2:-all}"

    case "$action" in
        start|stop|restart|reload) ;;
        *) die "invalid action '$action' (want start|stop|restart|reload)" 12 ;;
    esac

    if is_dryrun; then
        echo "WOULD-EXEC: systemctl $action php$target_ver-fpm" >&2
        printf '{"action":"%s","version":"%s","ok":true}\n' "$action" "$target_ver"
        exit 0
    fi

    if [ "$target_ver" != "all" ]; then
