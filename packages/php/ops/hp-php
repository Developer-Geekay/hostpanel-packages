        "$version" "${upload_max:-64M}" "${post_max:-64M}" "${mem_limit:-256M}" "${max_exec:-120}" "${max_input_time:-60}" "${max_input_vars:-1000}" "${tz:-UTC}" "${disp_err:-Off}" "${op_enable:-1}"
