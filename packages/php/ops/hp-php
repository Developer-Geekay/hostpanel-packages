    fi

    echo "  [2/4] Downloading PECL extension '$extension' source package..." >&2
    local tmp_pecl="/tmp/pecl-${version}-${extension}"
    rm -rf "$tmp_pecl" && mkdir -p "$tmp_pecl"

    (
        cd "$tmp_pecl"
        if [ -x "$pecl_bin" ]; then
            "$pecl_bin" download "$extension" 2>/dev/null || true
        fi
        if ! ls "$tmp_pecl"/*.tgz >/dev/null 2>&1; then
