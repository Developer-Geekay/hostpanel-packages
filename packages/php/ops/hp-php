    local phpize_bin="$runtime_dir/bin/phpize"
    local phpconfig_bin="$runtime_dir/bin/php-config"
    [ -x "$phpize_bin" ] || phpize_bin="$(command -v "phpize$version" 2>/dev/null || command -v phpize 2>/dev/null || echo "")"
    [ -x "$phpconfig_bin" ] || phpconfig_bin="$(command -v "php-config$version" 2>/dev/null || command -v php-config 2>/dev/null || echo "")"

    echo "  [1/3] Downloading extension '$extension' source package..." >&2
    local tmp_pecl="/tmp/ext-build-${version}-${extension}"
    rm -rf "$tmp_pecl" && mkdir -p "$tmp_pecl"

    (
        cd "$tmp_pecl"
        if [ -x "$pecl_bin" ]; then
            "$pecl_bin" download "$extension" 2>/dev/null || true
        fi
        if ! ls "$tmp_pecl"/*.tgz >/dev/null 2>&1; then
