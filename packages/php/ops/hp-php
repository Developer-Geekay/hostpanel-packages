  directives-set)
    require_argc 1 $# "directives-set <version> [upload_max] [post_max] [memory] [max_exec] [max_input_time] [max_input_vars] [timezone] [display_errors] [opcache]"
    version="$1"; shift
    valid_php_version "$version"
    require_version_installed "$version"

    ini_file="$HP_PHP_ETC_ROOT/$version/fpm/php.ini"
    if [ ! -f "$ini_file" ]; then
        ini_file="$HP_PHP_ETC_ROOT/$version/php.ini"
    fi
    if [ ! -f "$ini_file" ]; then
        ini_file="/etc/php/$version/fpm/php.ini"
    fi
    [ -f "$ini_file" ] || die "php.ini not found" 10

    set_val() {
        local key="$1" val="$2"
        [ -n "$val" ] || return 0
        if grep -q "^[[:space:]]*$key[[:space:]]*=" "$ini_file"; then
            sed -i -E "s|^[[:space:]]*$key[[:space:]]*=.*|$key = $val|g" "$ini_file"
