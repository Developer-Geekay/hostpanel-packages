            IFS=":" read -r ext_name ext_cat ext_desc ext_method <<< "$item"
            
            is_installed=false
            is_enabled=false
            is_builtin=false
            [ "$ext_method" = "builtin" ] && is_builtin=true

            # Check if .so exists or module is loaded
