    rm -rf "$tmp_pecl"

    echo "  [3/3] Activating configuration in conf.d and reloading FPM..." >&2
    ini_path="$HP_PHP_ETC_ROOT/$version/mods-available/${extension}.ini"
    mkdir -p "$HP_PHP_ETC_ROOT/$version/mods-available" "$HP_PHP_ETC_ROOT/$version/fpm/conf.d" 2>/dev/null || true
    echo "extension=${extension}.so" > "$ini_path"
    ln -sf "$ini_path" "$HP_PHP_ETC_ROOT/$version/fpm/conf.d/20-${extension}.ini" 2>/dev/null || true

    sync_isolated_runtime "$version"
    act systemctl reload "$(fpm_unit "$version")" 2>/dev/null || true

    echo "  ✓ Extension '$extension' installed and isolated successfully." >&2
    printf '{"version":"%s","extension":"%s","installed":true,"enabled":true}\n' "$version" "$extension"
    ;;

  extension-install-pecl)
