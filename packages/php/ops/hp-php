            fi

            # Check if enabled in conf.d
            if [ -d "$conf_dir" ] && ls "$conf_dir"/*"${ext_name}.ini" >/dev/null 2>&1; then
                is_enabled=true
                is_installed=true
            elif [ -d "/etc/php/$v/fpm/conf.d" ] && ls "/etc/php/$v/fpm/conf.d"/*"${ext_name}.ini" >/dev/null 2>&1; then
                is_enabled=true
                is_installed=true
            fi

            [ "$first" = "1" ] && first=0 || printf ','
            printf '{"version":"%s","name":"%s","category":"%s","description":"%s","installed":%s,"enabled":%s,"builtin":%s,"method":"%s"}' \
