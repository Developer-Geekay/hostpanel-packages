        fi
    }

    upload_max="${1:-}"; post_max="${2:-}"; mem_limit="${3:-}"; max_exec="${4:-}"; max_input_t="${5:-}"; max_input_v="${6:-}"; tz="${7:-}"; disp_err="${8:-}"; op_enable="${9:-}"

    if is_dryrun; then
        echo "WOULD-UPDATE: $ini_file with directives" >&2
        printf '{"version":"%s","updated":true}\n' "$version"
        exit 0
    fi

    set_val "upload_max_filesize" "$upload_max"
    set_val "post_max_size" "$post_max"
    set_val "memory_limit" "$mem_limit"
    set_val "max_execution_time" "$max_exec"
    set_val "max_input_time" "$max_input_t"
    set_val "max_input_vars" "$max_input_v"
    set_val "date.timezone" "$tz"
    set_val "display_errors" "$disp_err"
    set_val "opcache.enable" "$op_enable"

    # Also sync to /etc/php if different
    if [ "$ini_file" != "/etc/php/$version/fpm/php.ini" ] && [ -f "/etc/php/$version/fpm/php.ini" ]; then
        cp "$ini_file" "/etc/php/$version/fpm/php.ini" 2>/dev/null || true
    fi

    act systemctl reload "$(fpm_unit "$version")" 2>/dev/null || true
    printf '{"version":"%s","updated":true}\n' "$version"
    ;;

  # ── live logs ───────────────────────────────────────────────────────────────
  logs-get)
    [ $# -le 3 ] || die "expected 0 to 3 arguments" 12
    version="${1:-}"
    log_type="${2:-error}"
    lines_count="${3:-50}"

    [ -n "$version" ] || version="$(installed_versions | head -n 1 || echo "8.4")"
    lines_count=$(( lines_count > 500 ? 500 : (lines_count < 1 ? 50 : lines_count) ))

    log_path="$HP_PHP_LOG_ROOT/php${version}-fpm.log"
    [ -f "$log_path" ] || log_path="/var/log/php${version}-fpm.log"

    python3 - "$version" "$log_type" "$log_path" "$lines_count" "$(fpm_unit "$version")" <<'PYEOF'
import json, sys, os, subprocess

version, log_type, log_path, lines_str, unit = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
lines_count = int(lines_str)
lines = []

if os.path.isfile(log_path):
    try:
        with open(log_path, 'r', encoding='utf-8', errors='replace') as f:
            all_lines = f.read().splitlines()
            lines = all_lines[-lines_count:]
    except Exception:
        pass
else:
    try:
        res = subprocess.run(
            ["journalctl", "-u", unit, "-n", str(lines_count), "--no-pager", "--output=cat"],
            capture_output=True, text=True, timeout=3
        )
        if res.returncode == 0:
            lines = res.stdout.splitlines()
    except Exception:
        pass

print(json.dumps({
    "version": version,
    "type": log_type,
    "path": log_path,
    "lines": lines
}))
PYEOF
    ;;

  # ── pools ───────────────────────────────────────────────────────────────────
  list-pools)
    [ $# -le 1 ] || die "expected 0 or 1 argument(s), got $#" 12
    filter="${1:-}"
    if [ -n "$filter" ]; then
        valid_php_version "$filter"
        require_version_installed "$filter"
    fi

    printf '{"pools":['
    first=1
    for v in $(installed_versions); do
        [ -z "$filter" ] || [ "$v" = "$filter" ] || continue
        pooldir="$HP_PHP_ETC_ROOT/$v/fpm/pool.d"
        [ -d "$pooldir" ] || continue
        for conf in "$pooldir"/*.conf; do
            [ -f "$conf" ] || continue
            pool="$(basename "$conf" .conf)"
            [ "$first" = "1" ] && first=0 || printf ','
            pool_json "$pool" "$v" "$conf"
        done
    done
    printf ']}\n'
    ;;

  get-pool)
    require_argc 1 $# "get-pool <pool>"
    pool="$1"
    valid_pool_name "$pool"
    version="$(find_pool_version "$pool")" || die "pool '$pool' not found" 10
    conf="$(pool_conf_path "$pool" "$version")"
    pool_json "$pool" "$version" "$conf"
    printf '\n'
    ;;

  create-pool)
    require_argc 4 $# "create-pool <pool> <version> <memory-limit> <max-execution-time>"
    pool="$1"; version="$2"; memory_limit="$3"; max_exec="$4"
    valid_pool_name "$pool"
    valid_php_version "$version"
    valid_memory_limit "$memory_limit"
    valid_exec_time "$max_exec"
    guard_reserved_pool "$pool"
    require_version_installed "$version"

    if find_pool_version "$pool" >/dev/null 2>&1; then
        die "pool '$pool' already exists" 13
    fi

    conf="$(pool_conf_path "$pool" "$version")"
    if is_dryrun; then
        echo "WOULD-WRITE: $conf" >&2
    else
        render_pool "$pool" "$version" "$memory_limit" "$max_exec" | atomic_write "$conf" 0644
    fi

    act systemctl reload "$(fpm_unit "$version")" 2>/dev/null || true
    if is_dryrun; then
        printf '{"pool":"%s","version":"%s","memory_limit":"%s","max_execution_time":%s,"socket":"%s"}\n' \
            "$pool" "$version" "$memory_limit" "$max_exec" "$(pool_socket "$pool" "$version")"
    else
        pool_json "$pool" "$version" "$conf"
        printf '\n'
    fi
    ;;

  delete-pool)
    require_argc 1 $# "delete-pool <pool>"
    pool="$1"
    valid_pool_name "$pool"
    guard_reserved_pool "$pool"
    version="$(find_pool_version "$pool")" || die "pool '$pool' not found" 10

    conf="$(pool_conf_path "$pool" "$version")"
    if is_dryrun; then
        echo "WOULD-REMOVE: $conf" >&2
    else
        rm -f "$conf"
    fi
    rm -f "$(pool_socket "$pool" "$version")" 2>/dev/null || true
    act systemctl reload "$(fpm_unit "$version")" 2>/dev/null || true
    printf '{"pool":"%s","deleted":true}\n' "$pool"
    ;;

  set-pool-version)
    require_argc 2 $# "set-pool-version <pool> <new-version>"
    pool="$1"; new_version="$2"
    valid_pool_name "$pool"
    valid_php_version "$new_version"
    guard_reserved_pool "$pool"
    require_version_installed "$new_version"

    old_version="$(find_pool_version "$pool")" || die "pool '$pool' not found" 10
    [ "$old_version" != "$new_version" ] || die "pool '$pool' is already running PHP $new_version" 13

    old_conf="$(pool_conf_path "$pool" "$old_version")"
    new_conf="$(pool_conf_path "$pool" "$new_version")"
    memory_limit="$(grep '^php_admin_value\[memory_limit\]' "$old_conf" 2>/dev/null | awk '{print $NF}' || echo "128M")"
    max_exec="$(grep '^php_admin_value\[max_execution_time\]' "$old_conf" 2>/dev/null | awk '{print $NF}' || echo "30")"

    if is_dryrun; then
        echo "WOULD-MOVE: $old_conf -> $new_conf" >&2
    else
        render_pool "$pool" "$new_version" "$memory_limit" "$max_exec" | atomic_write "$new_conf" 0644
        rm -f "$old_conf"
    fi

    rm -f "$(pool_socket "$pool" "$old_version")" 2>/dev/null || true
    act systemctl reload "$(fpm_unit "$old_version")" 2>/dev/null || true
    act systemctl reload "$(fpm_unit "$new_version")" 2>/dev/null || true

    if is_dryrun; then
        printf '{"pool":"%s","version":"%s","moved":true}\n' "$pool" "$new_version"
    else
        pool_json "$pool" "$new_version" "$new_conf"
        printf '\n'
    fi
    ;;

  set-pool-limits)
    require_argc 3 $# "set-pool-limits <pool> <memory-limit> <max-execution-time>"
    pool="$1"; memory_limit="$2"; max_exec="$3"
    valid_pool_name "$pool"
    valid_memory_limit "$memory_limit"
    valid_exec_time "$max_exec"
    guard_reserved_pool "$pool"
    version="$(find_pool_version "$pool")" || die "pool '$pool' not found" 10

    conf="$(pool_conf_path "$pool" "$version")"
    if is_dryrun; then
        echo "WOULD-WRITE: $conf (mem=$memory_limit, exec=$max_exec)" >&2
    else
        render_pool "$pool" "$version" "$memory_limit" "$max_exec" | atomic_write "$conf" 0644
    fi
    act systemctl reload "$(fpm_unit "$version")" 2>/dev/null || true

    if is_dryrun; then
        printf '{"pool":"%s","version":"%s","memory_limit":"%s","max_execution_time":%s,"socket":"%s"}\n' \
            "$pool" "$version" "$memory_limit" "$max_exec" "$(pool_socket "$pool" "$version")"
    else
        pool_json "$pool" "$version" "$conf"
        printf '\n'
    fi
    ;;

  restart-fpm)
    [ $# -le 1 ] || die "expected 0 or 1 argument(s)" 12
    version="${1:-all}"
    if [ "$version" != "all" ] && [ -n "$version" ]; then
        valid_php_version "$version"
        require_version_installed "$version"
        act systemctl restart "$(fpm_unit "$version")" 2>/dev/null || true
        printf '{"version":"%s","restarted":true}\n' "$version"
    else
        for v in $(installed_versions); do
            act systemctl restart "$(fpm_unit "$v")" 2>/dev/null || true
        done
        printf '{"version":"all","restarted":true}\n'
    fi
    ;;

  *)
    die "unknown verb: $verb" 12
    ;;
esac
