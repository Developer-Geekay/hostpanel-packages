# HostPanel v3 — php feature service.
#
# ONE grant, ONE script path. hp-php cannot write to /etc/php/*/fpm/pool.d or
# restart/reload a php-fpm unit directly; only through this script, which
# validates every argument before acting.
#
# This grant is safe ONLY while the target stays root-owned and not writable by
# hp-php. If hp-php could write the script, this line would be a root shell.
# provision-service.sh asserts that ownership before installing this file, and
# refuses otherwise.
#
# Installed 0440 root:root by provision-service.sh, after visudo -c -f.

hp-php ALL=(root) NOPASSWD: /opt/hostpanel/packages/php/ops/hp-php *
