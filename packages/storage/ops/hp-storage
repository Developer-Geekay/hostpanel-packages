#!/bin/bash
# hp-storage — root helper for the HostPanel v3 S3 Object Storage daemon.
#
# Installed root-owned 0755. The daemon's sudoers file grants THIS SINGLE PATH:
#   hp-storage ALL=(root) NOPASSWD: /opt/hostpanel/packages/storage/ops/hp-storage *
#
# Verbs: storage-init bucket-create bucket-delete disk-usage service-restart firewall-allow
# Exit:  0 ok | 1 internal | 10 not found | 11 precondition | 12 validation | 13 conflict
#
# stdout is DATA (JSON where structured). stderr is DIAGNOSTICS.

set -euo pipefail

export PATH="/opt/hostpanel/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"

OPS_NAME="hp-storage"
if [ "$(id -u)" = "0" ]; then
    HP_CORE_LIB=/opt/hostpanel/hpcore/lib
else
    : "${HP_CORE_LIB:=/opt/hostpanel/hpcore/lib}"
fi

if [ -f "$HP_CORE_LIB/common.sh" ]; then
    # shellcheck disable=SC1091
    . "$HP_CORE_LIB/common.sh"
else
    die() { echo "{\"error\":\"$1\"}" >&2; exit "${2:-1}"; }
    is_dryrun() { [ "${HP_DRYRUN:-0}" = "1" ]; }
    act() { "$@"; }
    no_traversal() { [[ "$1" =~ \.\. ]] && die "path traversal rejected" 12; }
    require_argc() { [ "$2" -ge "$1" ] || die "missing arguments" 12; }
fi

HP_BASE_ROOT="${HP_BASE_ROOT:-/opt/hostpanel}"
HP_DEFAULT_STORAGE_ROOT="/data/storage/buckets"
HP_STORAGE_ROOT="${HP_STORAGE_ROOT:-}"

if [ -z "$HP_STORAGE_ROOT" ]; then
    DB_PATH="/opt/hostpanel/data/storage/storage.db"
    if [ -f "$DB_PATH" ]; then
        if command -v sqlite3 >/dev/null 2>&1; then
            HP_STORAGE_ROOT="$(sqlite3 "$DB_PATH" "SELECT value FROM storage_settings WHERE key='storage_path' LIMIT 1;" 2>/dev/null || true)"
        elif command -v python3 >/dev/null 2>&1; then
            HP_STORAGE_ROOT="$(python3 -c "import sqlite3; conn = sqlite3.connect('$DB_PATH'); row = conn.execute(\"SELECT value FROM storage_settings WHERE key='storage_path' LIMIT 1\").fetchone(); print(row[0] if row and row[0] else '')" 2>/dev/null || true)"
        fi
    fi
fi
HP_STORAGE_ROOT="${HP_STORAGE_ROOT:-$HP_DEFAULT_STORAGE_ROOT}"

HP_ETC_STORAGE="${HP_ETC_STORAGE:-/opt/hostpanel/etc/storage}"
HP_LOGS_STORAGE="${HP_LOGS_STORAGE:-/opt/hostpanel/logs/storage}"
HP_RUN_STORAGE="${HP_RUN_STORAGE:-/opt/hostpanel/run/storage}"

valid_bucket_name() {
    local b="$1"
    [ -n "$b" ] || die "bucket name must not be empty" 12
    echo "$b" | grep -Eq '^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$' \
        || die "invalid bucket name '$b' (want ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]\$)" 12
    no_traversal "$b"
}

# ── engine-status ────────────────────────────────────────────────────────────
op_engine_status() {
    local is_installed=false
    if [ -d "$HP_STORAGE_ROOT" ] && [ -d "/opt/hostpanel/data/storage" ]; then
        is_installed=true
    fi
    printf '{"ok":true,"installed":%s,"storage_root":"%s"}\n' "$is_installed" "$HP_STORAGE_ROOT"
    return 0
}

# ── storage-init ─────────────────────────────────────────────────────────────
op_storage_init() {
    if is_dryrun; then
        echo "WOULD-EXEC: initialize storage directories under $HP_BASE_ROOT and $HP_STORAGE_ROOT" >&2
        printf '{"ok":true,"initialized":true}\n'
        return 0
    fi

    mkdir -p "$HP_STORAGE_ROOT" "$HP_ETC_STORAGE" "$HP_LOGS_STORAGE" "$HP_RUN_STORAGE" "/opt/hostpanel/data/storage"
    touch "/opt/hostpanel/data/storage/storage.db" 2>/dev/null || true

    if getent passwd hp-storage >/dev/null 2>&1; then
        chown -R hp-storage:hp-storage "$HP_STORAGE_ROOT" "/opt/hostpanel/data/storage" "$HP_ETC_STORAGE" "$HP_LOGS_STORAGE" "$HP_RUN_STORAGE" 2>/dev/null || true
    fi
    chmod 0775 "$HP_STORAGE_ROOT" "$HP_ETC_STORAGE" "$HP_LOGS_STORAGE" "$HP_RUN_STORAGE" "/opt/hostpanel/data/storage"
    [ -f "/opt/hostpanel/data/storage/storage.db" ] && chmod 0664 "/opt/hostpanel/data/storage/storage.db" 2>/dev/null || true

    # Configure UFW firewall for S3 port 9000 if UFW is active
    if command -v ufw >/dev/null 2>&1; then
        if ufw status 2>/dev/null | grep -qi "status: active"; then
            ufw allow 9000/tcp comment "HostPanel S3 Object Storage" >/dev/null 2>&1 || true
        fi
    fi

    printf '{"ok":true,"initialized":true,"storage_root":"%s"}\n' "$HP_STORAGE_ROOT"
}

# ── bucket-create ────────────────────────────────────────────────────────────
op_bucket_create() {
    require_argc 1 $# "bucket-create <name>"
    local name="$1"
    valid_bucket_name "$name"
    local bpath="$HP_STORAGE_ROOT/$name"

    if is_dryrun; then
        echo "WOULD-EXEC: mkdir -p $bpath" >&2
        printf '{"ok":true,"name":"%s","created":true}\n' "$name"
        return 0
    fi

    if [ -d "$bpath" ]; then
        die "bucket '$name' already exists" 13
    fi

    mkdir -p "$bpath"
    if getent passwd hp-storage >/dev/null 2>&1; then
        chown -R hp-storage:hp-storage "$bpath" 2>/dev/null || true
    fi
    chmod 0755 "$bpath"

    printf '{"ok":true,"name":"%s","path":"%s","created":true}\n' "$name" "$bpath"
}

# ── bucket-delete ────────────────────────────────────────────────────────────
op_bucket_delete() {
    require_argc 1 $# "bucket-delete <name>"
    local name="$1"
    valid_bucket_name "$name"
    local bpath="$HP_STORAGE_ROOT/$name"

    if is_dryrun; then
        echo "WOULD-EXEC: rm -rf $bpath" >&2
        printf '{"ok":true,"name":"%s","deleted":true}\n' "$name"
        return 0
    fi

    [ -d "$bpath" ] || die "bucket '$name' does not exist" 10

    rm -rf "$bpath" || die "failed deleting bucket '$name'" 1
    printf '{"ok":true,"name":"%s","deleted":true}\n' "$name"
}

# ── disk-usage ───────────────────────────────────────────────────────────────
op_disk_usage() {
    if is_dryrun; then
        printf '{"total_bytes":107374182400,"used_bytes":14200000000,"free_bytes":93174182400}\n'
        return 0
    fi

    python3 -c '
import os, sys, shutil, json

storage_root = sys.argv[1]
base_root = sys.argv[2]

def get_dir_size(path):
    if not os.path.exists(path):
        return 0, 0
    total_size = 0
    file_count = 0
    try:
        for root, dirs, files in os.walk(path):
            for f in files:
                fp = os.path.join(root, f)
                try:
                    total_size += os.path.getsize(fp)
                    file_count += 1
                except OSError:
                    pass
    except Exception:
        pass
    return total_size, file_count

try:
    total, used, free = shutil.disk_usage(base_root if os.path.exists(base_root) else "/")
except Exception:
    total, used, free = 100 * 1024**3, 10 * 1024**3, 90 * 1024**3

s3_bytes, s3_files = get_dir_size(storage_root)

buckets_stats = []
if os.path.isdir(storage_root):
    for entry in sorted(os.listdir(storage_root)):
        bp = os.path.join(storage_root, entry)
        if os.path.isdir(bp) and not entry.startswith("."):
            b_sz, b_cnt = get_dir_size(bp)
            buckets_stats.append({"name": entry, "size_bytes": b_sz, "object_count": b_cnt})

print(json.dumps({
    "ok": True,
    "total_bytes": total,
    "used_bytes": used,
    "free_bytes": free,
    "s3_storage_bytes": s3_bytes,
    "s3_objects_count": s3_files,
    "buckets": buckets_stats
}))
' "$HP_STORAGE_ROOT" "$HP_BASE_ROOT"
}

# ── service-restart ──────────────────────────────────────────────────────────
op_service_restart() {
    if is_dryrun; then
        echo "WOULD-EXEC: systemctl restart hostpanel-storaged.service" >&2
        printf '{"ok":true,"restarted":true}\n'
        return 0
    fi

    systemctl restart hostpanel-storaged.service 2>/dev/null || true
    printf '{"ok":true,"restarted":true}\n'
}

# ── firewall-allow ───────────────────────────────────────────────────────────
op_firewall_allow() {
    local port="${1:-9000}"
    if command -v ufw >/dev/null 2>&1; then
        ufw allow "${port}/tcp" comment "HostPanel S3 Object Storage" >/dev/null 2>&1 || true
    fi
    printf '{"ok":true,"port":%d,"allowed":true}\n' "$port"
}

# ── dispatch ─────────────────────────────────────────────────────────────────
[ $# -gt 0 ] || die "usage: hp-storage <verb> [args]" 12
verb="$1"; shift

case "$verb" in
    engine-status)    op_engine_status "$@" ;;
    engine-install)   op_storage_init "$@" ;;
    storage-init)     op_storage_init "$@" ;;
    bucket-create)    op_bucket_create "$@" ;;
    bucket-delete)    op_bucket_delete "$@" ;;
    disk-usage)       op_disk_usage "$@" ;;
    service-restart)  op_service_restart "$@" ;;
    firewall-allow)   op_firewall_allow "$@" ;;
    *)                die "unknown verb '$verb'" 12 ;;
esac
