{
  "manifest_version": 1,
  "feature": "storage",
  "label": "Object Storage (S3)",
  "version": "3.1.1",
  "requires_core": [
    3,
    0,
    0
  ],
  "api": {
    "module": "hostpanel_storaged",
    "unit": "hostpanel-storaged.service",
    "run_as": "hp-storage"
  },
  "frontend": {
    "entry": "frontend/dist/main.js"
  },
  "nav": [
    {
      "section": "hosting",
      "section_label": "Hosting",
      "section_order": 30,
      "label": "Object Storage (S3)",
      "icon": "cloud_queue",
      "order": 35
    }
  ],
  "ops": {
    "script": "/opt/hostpanel/packages/storage/ops/hp-storage",
    "sudoers": "hostpanel-storaged"
  },
  "sandbox": {
    "read_write_paths": [
      "/opt/hostpanel/data/storage",
      "/opt/hostpanel/etc/storage",
      "/opt/hostpanel/logs/storage",
      "/opt/hostpanel/run/storage",
      "/tmp"
    ]
  },
  "operations": {
    "storage.bucket-create": {
      "verb": "bucket-create",
      "mutating": true,
      "streams": false,
      "audit_action": "storage.bucket.create",
      "timeout_ms": 15000,
      "params": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
          "required": true
        }
      }
    },
    "storage.bucket-delete": {
      "verb": "bucket-delete",
      "mutating": true,
      "streams": false,
      "audit_action": "storage.bucket.delete",
      "timeout_ms": 15000,
      "params": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
          "required": true
        }
      }
    },
    "storage.storage-init": {
      "verb": "storage-init",
      "mutating": true,
      "streams": false,
      "audit_action": "storage.init",
      "timeout_ms": 15000,
      "params": {}
    },
    "storage.disk-usage": {
      "verb": "disk-usage",
      "mutating": false,
      "streams": false,
      "audit_action": "storage.disk_usage",
      "timeout_ms": 20000,
      "params": {}
    },
    "storage.service-restart": {
      "verb": "service-restart",
      "mutating": true,
      "streams": false,
      "audit_action": "storage.service.restart",
      "timeout_ms": 20000,
      "params": {}
    }
  }
}
