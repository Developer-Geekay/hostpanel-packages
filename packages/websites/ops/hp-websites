op_vhost_htaccess_get() {
    [ $# -ge 1 ] && [ $# -le 2 ] || die "usage: hp-websites vhost-htaccess-get <domain>" 12
    local domain="$1"
    validate_domain "$domain"
    local doc_root="/opt/hostpanel/data/vhosts/$domain/public_html"
    local htfile="$doc_root/.htaccess"

    local content=""
    if [ -f "$htfile" ]; then
        content="$(cat "$htfile" 2>/dev/null || true)"
    fi

    printf '{"domain":"%s","content":%s}\n' \
        "$domain" \
        "$(python3 -c "import json,sys; print(json.dumps(sys.stdin.read()))" <<< "$content")"
}

op_vhost_htaccess_set() {
    [ $# -ge 2 ] && [ $# -le 3 ] || die "usage: hp-websites vhost-htaccess-set <domain> <content_b64>" 12
    local domain="$1"
    local content_b64="$2"
    validate_domain "$domain"

    if [ "$DRY_RUN" = "1" ]; then
        printf '{"status":"htaccess_saved","domain":"%s"}\n' "$domain"
        return 0
    fi

    local doc_root="/opt/hostpanel/data/vhosts/$domain/public_html"
    mkdir -p "$doc_root"
    echo "$content_b64" | base64 -d > "$doc_root/.htaccess"
    reload_servers

    printf '{"status":"htaccess_saved","domain":"%s"}\n' "$domain"
}

[ $# -ge 1 ] || usage

VERB="$1"
shift

case "$VERB" in
    vhost-list) op_vhost_list "$@" ;;
    vhost-get) op_vhost_get "$@" ;;
    vhost-create) op_vhost_create "$@" ;;
    vhost-update) op_vhost_update "$@" ;;
    vhost-delete) op_vhost_delete "$@" ;;
    vhost-logs) op_vhost_logs "$@" ;;
    vhost-ssl-get) op_vhost_ssl_get "$@" ;;
    vhost-ssl-set) op_vhost_ssl_set "$@" ;;
    vhost-ssl-selfsigned) op_vhost_ssl_selfsigned "$@" ;;
    vhost-security-get) op_vhost_security_get "$@" ;;
    vhost-security-set) op_vhost_security_set "$@" ;;
    vhost-php-get) op_vhost_php_get "$@" ;;
    vhost-php-set) op_vhost_php_set "$@" ;;
    vhost-htaccess-get) op_vhost_htaccess_get "$@" ;;
    vhost-htaccess-set) op_vhost_htaccess_set "$@" ;;
    engine-check) op_engine_check "$@" ;;
    *) die "unknown verb: $VERB" 12 ;;
esac
