cmd_grant() {
  local username="$1"
  local db="$2"
  local privs="${3:-ALL PRIVILEGES}"
  local host="${4:-%}"

  if [[ ! "$username" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,31}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid username: $username\",\"code\":\"INVALID_USERNAME\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  if [[ ! "$db" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,63}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid database: $db\",\"code\":\"INVALID_DATABASE\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  # Revoke previous privileges on this specific database first so unchecked privileges are removed
  run_mysql "REVOKE ALL PRIVILEGES ON \`$db\`.* FROM \`$username\`@'$host';" 2>/dev/null || true

  local sql="GRANT $privs ON \`$db\`.* TO \`$username\`@'$host'; FLUSH PRIVILEGES;"
  if ! run_mysql "$sql"; then
    echo "{\"ok\":false,\"error\":\"Failed to grant privileges on '$db' to '$username'@'$host'\",\"code\":\"EXECUTION_FAILED\"}" >&2
    return $EXIT_EXECUTION_FAILED
  fi

  echo "{\"ok\":true,\"username\":\"$username\",\"database\":\"$db\",\"privileges\":\"$privs\",\"host\":\"$host\"}"
  return $EXIT_SUCCESS
}

cmd_revoke() {
  local username="$1"
  local db="$2"
  local host="${3:-%}"

  if [[ ! "$username" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,31}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid username: $username\",\"code\":\"INVALID_USERNAME\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  if [[ ! "$db" =~ ^[a-zA-Z_][a-zA-Z0-9_]{0,63}$ ]]; then
    echo "{\"ok\":false,\"error\":\"Invalid database: $db\",\"code\":\"INVALID_DATABASE\"}" >&2
    return $EXIT_INVALID_INPUT
  fi

  local sql="REVOKE ALL PRIVILEGES ON \`$db\`.* FROM \`$username\`@'$host'; FLUSH PRIVILEGES;"
  if ! run_mysql "$sql"; then
    echo "{\"ok\":false,\"error\":\"Failed to revoke privileges for '$username'@'$host' on '$db'\",\"code\":\"EXECUTION_FAILED\"}" >&2
    return $EXIT_EXECUTION_FAILED
  fi

  echo "{\"ok\":true,\"username\":\"$username\",\"database\":\"$db\",\"revoked\":true,\"host\":\"$host\"}"
  return $EXIT_SUCCESS
}

# ==================== ENGINE SERVICE LIFECYCLE ====================

cmd_engine_status() {
  local service="mariadb"
  local active=false
  local pid=0
  local uptime="0s"
  local status_text="stopped"

  # Find active unit
  for u in "mariadb.service" "mysql.service"; do
    if systemctl is-active --quiet "$u" 2>/dev/null; then
      service="${u%.service}"
      active=true
      status_text="running"
      pid="$(systemctl show -p MainPID --value "$u" 2>/dev/null || echo "0")"
      local uptime_sec
      uptime_sec="$(ps -p "$pid" -o etimes= 2>/dev/null | tr -d ' ' || echo "0")"
      if [[ "$uptime_sec" -gt 86400 ]]; then
        uptime="$((uptime_sec / 86400))d $((uptime_sec % 86400 / 3600))h"
      elif [[ "$uptime_sec" -gt 3600 ]]; then
        uptime="$((uptime_sec / 3600))h $((uptime_sec % 3600 / 60))m"
      else
        uptime="${uptime_sec}s"
      fi
      break
    fi
  done

  # Look up version
  local version=""
  if [[ -n "$MYSQLD_BIN" ]]; then
    local raw_v
    raw_v="$("$MYSQLD_BIN" --version 2>/dev/null || echo "")"
    if [[ "$raw_v" =~ (MariaDB[[:space:]]+[0-9]+\.[0-9]+\.[0-9]+) ]]; then
      version="${BASH_REMATCH[1]}"
    elif [[ "$raw_v" =~ Ver[[:space:]]+([0-9]+\.[0-9]+\.[0-9]+) ]]; then
      version="MariaDB ${BASH_REMATCH[1]}"
    else
      version="MariaDB"
    fi
  fi

  local conns=0
  if [[ "$active" == "true" ]]; then
    local c
    c="$(run_mysql "SELECT COUNT(*) FROM information_schema.processlist;" 2>/dev/null || echo "0")"
    conns="$(echo "$c" | grep -Eo '^[0-9]+$' | tail -n 1 || echo "0")"
    conns="${conns:-0}"
  fi

  echo "{\"ok\":true,\"engine\":\"mysql\",\"service\":\"$service\",\"status\":\"$status_text\",\"active\":$active,\"pid\":$pid,\"uptime\":\"$uptime\",\"version\":\"$version\",\"connections\":$conns,\"port\":3306}"
  return $EXIT_SUCCESS
}

cmd_engine_start() {
  echo "[1/3] Preparing /opt/hostpanel isolated directories..."
  mkdir -p "$DATA_DIR" "$LOG_DIR" "$RUN_DIR"
  chown -R mysql:mysql "$DATA_DIR" "$LOG_DIR" "$RUN_DIR" 2>/dev/null || true

  echo "[2/3] Starting MySQL/MariaDB service..."
  systemctl start mariadb.service 2>/dev/null || systemctl start mysql.service 2>/dev/null || true

  echo "[3/3] Checking MySQL socket and service readiness..."
  sleep 0.5
  local pid
  pid="$(systemctl show -p MainPID --value mariadb.service 2>/dev/null || systemctl show -p MainPID --value mysql.service 2>/dev/null || echo "0")"
  echo "✓ MySQL/MariaDB daemon is active (PID $pid, port 3306)."
  echo '{"ok":true,"action":"start","status":"active"}'
  return $EXIT_SUCCESS
}

cmd_engine_stop() {
  echo "[1/2] Sending termination signal to MySQL/MariaDB service..."
  systemctl stop mariadb.service 2>/dev/null || systemctl stop mysql.service 2>/dev/null || true

  echo "[2/2] Verifying process shutdown and cleaning socket locks..."
  sleep 0.3
  echo "✓ MySQL/MariaDB service stopped."
  echo '{"ok":true,"action":"stop","status":"inactive"}'
  return $EXIT_SUCCESS
}

cmd_engine_restart() {
  echo "[1/4] Stopping active MySQL/MariaDB daemon..."
  systemctl stop mariadb.service 2>/dev/null || systemctl stop mysql.service 2>/dev/null || true

  echo "[2/4] Verifying isolated directories and runtime permissions..."
  mkdir -p "$DATA_DIR" "$LOG_DIR" "$RUN_DIR"
  chown -R mysql:mysql "$DATA_DIR" "$LOG_DIR" "$RUN_DIR" 2>/dev/null || true

  echo "[3/4] Starting MySQL/MariaDB service..."
  systemctl start mariadb.service 2>/dev/null || systemctl start mysql.service 2>/dev/null || true

  echo "[4/4] Verifying Unix domain socket connection..."
  sleep 0.5
  local pid
  pid="$(systemctl show -p MainPID --value mariadb.service 2>/dev/null || systemctl show -p MainPID --value mysql.service 2>/dev/null || echo "0")"
  echo "✓ MySQL/MariaDB restarted successfully (PID $pid)."
  echo '{"ok":true,"action":"restart","status":"active"}'
  return $EXIT_SUCCESS
}

cmd_engine_reload() {
  echo "[1/2] Reloading MySQL configuration ($CONF_FILE)..."
  for u in "mariadb.service" "mysql.service"; do
    if systemctl is-active --quiet "$u" 2>/dev/null; then
      systemctl reload "$u" 2>/dev/null || systemctl restart "$u" 2>/dev/null || true
      break
    fi
  done

  echo "[2/2] Validating daemon health status..."
  sleep 0.5
  local pid
  pid="$(systemctl show -p MainPID --value mariadb.service 2>/dev/null || systemctl show -p MainPID --value mysql.service 2>/dev/null || echo "0")"
  echo "✓ MySQL/MariaDB configuration reloaded (PID $pid)."
  echo '{"ok":true,"action":"reload","status":"active"}'
  return $EXIT_SUCCESS
}

cmd_engine_config_get() {
  local target="$CONF_FILE"
  if [[ ! -f "$target" ]]; then
    if [[ -f "/etc/mysql/my.cnf" ]]; then
      target="/etc/mysql/my.cnf"
    elif [[ -f "/etc/my.cnf" ]]; then
      target="/etc/my.cnf"
    fi
  fi

  local content=""
  if [[ -f "$target" ]]; then
    content="$(cat "$target")"
  fi
  python3 -c 'import sys, json; print(json.dumps({"ok": True, "path": sys.argv[1], "content": sys.argv[2]}))' "$target" "$content"
  return $EXIT_SUCCESS
}

cmd_engine_config_set() {
  local content=""
  if [[ ! -t 0 ]]; then
    content="$(read_secret "content")"
  fi

  if [[ -z "$content" ]]; then
    echo '{"ok":false,"error":"Configuration content required on stdin payload","code":"MISSING_CONTENT"}' >&2
    return $EXIT_INVALID_INPUT
  fi

  mkdir -p "$CONF_DIR"
  echo "$content" > "$CONF_FILE"
  chmod 0644 "$CONF_FILE"

  # Also update system fallback if writable
  if [[ -d "/etc/mysql" ]]; then
    echo "$content" > "/etc/mysql/my.cnf" 2>/dev/null || true
  fi

  echo "{\"ok\":true,\"path\":\"$CONF_FILE\",\"saved\":true}"
  return $EXIT_SUCCESS
}

cmd_engine_logs() {
  local lines="${1:-50}"
  if [[ ! "$lines" =~ ^[0-9]+$ ]]; then
    lines=50
  fi
  local out=""
  for u in "mariadb.service" "mysql.service" "hostpanel-mariadbd.service"; do
    if systemctl is-active --quiet "$u" 2>/dev/null; then
      out="$(journalctl -u "$u" -n "$lines" --no-pager 2>/dev/null || true)"
      break
    fi
  done
  if [[ -z "$out" && -f "$LOG_FILE" ]]; then
    out="$(tail -n "$lines" "$LOG_FILE" 2>/dev/null || true)"
  fi
  if [[ -z "$out" && -f "/var/log/mysql/error.log" ]]; then
    out="$(tail -n "$lines" "/var/log/mysql/error.log" 2>/dev/null || true)"
  fi
  python3 -c 'import sys, json; print(json.dumps({"ok": True, "lines": sys.argv[1], "content": sys.argv[2]}))' "$lines" "${out:-No log output recorded.}"
  return $EXIT_SUCCESS
}

cmd_engine_install() {
  echo "============================================================"
  echo "  HostPanel v3 — MySQL / MariaDB Engine Provisioner"
  echo "============================================================"
  echo

  mkdir -p "$CONF_DIR" "$DATA_DIR" "$LOG_DIR" "$RUN_DIR" "$RUNTIME_DIR"
  chown -R hp-mysql:hp-mysql "$DATA_DIR" "$LOG_DIR" "$RUN_DIR" 2>/dev/null || true

  echo "[1/4] Checking MariaDB / MySQL binaries..."
  if [[ -n "$MYSQL_BIN" && -n "$MYSQLD_BIN" ]]; then
    echo "  Found installed binary: $($MYSQL_BIN --version 2>/dev/null || echo "$MYSQL_BIN")"
  else
    echo "  Downloading portable MariaDB runtime..."
    local arch
    arch="$(uname -m)"
    echo "  Architecture: $arch"
    if command -v apt-get >/dev/null 2>&1; then
      echo "  Provisioning mariadb-server packages via apt..."
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -y || true
      apt-get install -y --no-install-recommends mariadb-server mariadb-client || true
    fi
  fi

  echo
  echo "[2/4] Initializing /opt/hostpanel isolated directories..."
  mkdir -p "$CONF_DIR" "$DATA_DIR" "$LOG_DIR" "$RUN_DIR"
  chown -R mysql:mysql "$DATA_DIR" "$LOG_DIR" "$RUN_DIR" 2>/dev/null || chown -R hp-mysql:hp-mysql "$DATA_DIR" "$LOG_DIR" "$RUN_DIR" 2>/dev/null || true
  chmod 0750 "$DATA_DIR" "$LOG_DIR" "$RUN_DIR"

  if [[ ! -d "$DATA_DIR/mysql" ]]; then
    echo "  Initializing new MariaDB system tables..."
    mariadb-install-db --user=mysql --datadir="$DATA_DIR" || mysql_install_db --user=mysql --datadir="$DATA_DIR" || true
  fi

  echo
  echo "[3/4] Configuring isolated MySQL parameters & systemd unit..."
  if [[ ! -f "$CONF_FILE" ]]; then
    cat > "$CONF_FILE" <<EOF
[mysqld]
datadir = $DATA_DIR
socket = $RUN_DIR/mysqld.sock
port = 3306
bind-address = 127.0.0.1
log-error = $LOG_DIR/mariadb.log
pid-file = $RUN_DIR/mariadb.pid
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

[client]
socket = $RUN_DIR/mysqld.sock
EOF
    chmod 0644 "$CONF_FILE"
    echo "  Created configuration: $CONF_FILE"
  fi

  mkdir -p /etc/systemd/system/mariadb.service.d
  cat > /etc/systemd/system/mariadb.service.d/hostpanel.conf <<EOF
[Service]
ExecStart=
ExecStart=/usr/sbin/mariadbd --defaults-file=$CONF_FILE
ProtectSystem=off
ProtectHome=false
ReadOnlyPaths=/opt/hostpanel/etc
ReadWritePaths=$DATA_DIR $LOG_DIR $RUN_DIR
EOF
  systemctl daemon-reload

  echo
  echo "[4/4] Starting service and validating engine..."
  systemctl restart mariadb.service 2>/dev/null || systemctl enable --now mariadb.service 2>/dev/null || systemctl enable --now mysql.service 2>/dev/null || true
  sleep 1

  echo
  echo "✓ MariaDB / MySQL engine ready and isolated under /opt/hostpanel"
  echo '{"ok":true,"engine":"mysql","status":"installed"}'
  return $EXIT_SUCCESS
}

