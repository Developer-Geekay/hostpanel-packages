# HostPanel v3 — users feature service.
#
# ONE grant, ONE script path. hp-users cannot invoke useradd, userdel, usermod or
# chpasswd directly; only through this script, which validates every argument
# before acting.
#
# This grant is safe ONLY while the target stays root-owned and not writable by
# hp-users. If hp-users could write the script, this line would be a root shell.
# provision-service.sh asserts that ownership before installing this file, and
# refuses otherwise.
#
# Installed 0440 root:root by provision-service.sh, after visudo -c -f.

hp-users ALL=(root) NOPASSWD: /opt/hostpanel/packages/users/ops/hp-users *
